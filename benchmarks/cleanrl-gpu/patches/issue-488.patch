 def make_env(env_id, idx, capture_video, run_name):
+    """
+    ToyText envs (e.g. FrozenLake-v1) expose a Discrete observation space, which
+    PPO's fully-connected network cannot consume directly. OneHotObservation
+    converts a Discrete observation space into a one-hot Box space so the rest of
+    the algorithm runs unchanged; Box-space envs are left untouched.
+    """
+
+    class OneHotObservation(gym.ObservationWrapper):
+        def __init__(self, env):
+            super().__init__(env)
+            assert isinstance(env.observation_space, gym.spaces.Discrete)
+            self.n = env.observation_space.n
+            self.observation_space = gym.spaces.Box(0, 1, (self.n,), dtype=np.float32)
+
+        def observation(self, observation):
+            onehot = np.zeros(self.n, dtype=np.float32)
+            onehot[observation] = 1.0
+            return onehot
+
     def thunk():
         if capture_video and idx == 0:
             env = gym.make(env_id, render_mode="rgb_array")
