@@ -0,0 +1,41 @@
+import subprocess
+import sys
+
+
+def test_ppo_frozenlake():
+    # Regression for issue #488: ToyText envs (FrozenLake-v1) expose a Discrete
+    # observation space that PPO must support via one-hot encoding.
+    subprocess.run(
+        [
+            sys.executable,
+            "cleanrl/ppo.py",
+            "--env-id",
+            "FrozenLake-v1",
+            "--num-envs",
+            "1",
+            "--num-steps",
+            "64",
+            "--total-timesteps",
+            "256",
+        ],
+        check=True,
+    )
+
+
+def test_ppo_box_space_unchanged():
+    # Box-space PPO (CartPole-v1) must keep working after the ToyText fix.
+    subprocess.run(
+        [
+            sys.executable,
+            "cleanrl/ppo.py",
+            "--env-id",
+            "CartPole-v1",
+            "--num-envs",
+            "1",
+            "--num-steps",
+            "64",
+            "--total-timesteps",
+            "256",
+        ],
+        check=True,
+    )
