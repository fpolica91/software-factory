install_cli() {
  local install_dir=${FACTORY_INSTALL_DIR:-$HOME/.local/bin}
  local target=$install_dir/factory
  local expected=$PRODUCT_ROOT/factory

  mkdir -p "$install_dir"
  if [[ -L "$target" ]]; then
    if [[ "$(readlink "$target")" == "$expected" ]]; then
      printf 'factory is already installed at %s\n' "$target"
      return
    fi
    die "$target is already a symlink to a different file"
  fi
  [[ ! -e "$target" ]] || die "$target already exists"
  ln -s "$expected" "$target"
  printf 'Installed factory at %s\n' "$target"
  case ":$PATH:" in
    *":$install_dir:"*) ;;
    *) printf 'Add %s to PATH before using `factory` from another repository.\n' "$install_dir" ;;
  esac
}

ensure_env_file() {
  local existing_image
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_EXAMPLE" ]] || die "missing $ENV_EXAMPLE"
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi

  if [[ -z ${FACTORY_IMAGE+x} ]]; then
    existing_image=$(env_file_value FACTORY_IMAGE)
    if [[ "$existing_image" == software-factory:local ]]; then
      write_env_value FACTORY_IMAGE "$DEFAULT_FACTORY_IMAGE"
      printf 'Updated Factory to use the prebuilt image %s\n' "$DEFAULT_FACTORY_IMAGE" >&2
    fi
  fi
}

env_file_value() {
  local key=$1 line value=''
  [[ -f "$ENV_FILE" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      value=${line#*=}
    fi
  done < "$ENV_FILE"

  if [[ ${#value} -ge 2 ]]; then
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
      value=${value:1:${#value}-2}
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value=${value:1:${#value}-2}
    fi
  fi
  printf '%s' "$value"
}

configured_value() {
  local key=$1
  if declare -p "$key" >/dev/null 2>&1; then
    printf '%s' "${!key}"
  else
    env_file_value "$key"
  fi
}

write_env_value() {
  local key=$1 value=$2 line
  local found=0
  local temporary=$ENV_FILE.tmp.$$

  : > "$temporary"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      printf '%s=%s\n' "$key" "$value" >> "$temporary"
      found=1
    else
      printf '%s\n' "$line" >> "$temporary"
    fi
  done < "$ENV_FILE"
  if (( found == 0 )); then
    printf '\n%s=%s\n' "$key" "$value" >> "$temporary"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$ENV_FILE"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die 'Docker is required'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose is required'
  docker info >/dev/null 2>&1 || die 'Docker is not running'
  [[ -f "$COMPOSE_FILE" ]] || die "missing $COMPOSE_FILE"
}

value_is_blank() {
  local value=$1
  [[ ! "$value" =~ [^[:space:]] ]]
}

PROVIDER_CONFIG_ERRORS=()
validate_provider_configuration() {
  local adapter provider base_url model authentication api_key bridge_token catalog upstream_base_url scoped_api_key
  PROVIDER_CONFIG_ERRORS=()
  adapter=$(configured_value FACTORY_PROVIDER_ADAPTER)

  if [[ -z "$adapter" ]]; then
    PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_ADAPTER is required")
  elif [[ "$adapter" != openai && "$adapter" != responses && "$adapter" != claude &&
          "$adapter" != zai && "$adapter" != deepseek ]]; then
    PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_ADAPTER must be one of: openai, claude, deepseek, zai, responses")
    return 1
  fi

  if [[ -z "$adapter" || "$adapter" == responses || "$adapter" == openai ]]; then
    provider=$(configured_value FACTORY_MODEL_PROVIDER)
    base_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
    model=$(configured_value FACTORY_MODEL)
    authentication=$(configured_value FACTORY_PROVIDER_AUTH)
    api_key=$(configured_value FACTORY_PROVIDER_API_KEY)

    if value_is_blank "$provider"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER is required")
    elif [[ ! "$provider" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER must start with an alphanumeric character and contain only alphanumeric characters, hyphens, or underscores")
    fi
    if value_is_blank "$base_url"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL is required")
    elif [[ "$base_url" != http://* && "$base_url" != https://* ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must start with http:// or https://")
    elif [[ "$base_url" == *[[:space:]]* ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must not contain whitespace")
    fi
    if value_is_blank "$model"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL is required")
    elif [[ "$model" == *$'\n'* || "$model" == *$'\r'* ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL must be a single line")
    fi
    if [[ -z "$authentication" ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_AUTH is required")
    elif [[ "$authentication" != key && "$authentication" != none ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_AUTH must be one of: key, none for a direct Responses provider")
    elif [[ "$authentication" == key ]] && value_is_blank "$api_key"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_API_KEY is required when FACTORY_PROVIDER_AUTH=key")
    fi
    if [[ "$adapter" == openai ]]; then
      scoped_api_key=$(configured_value OPENAI_API_KEY)
      [[ "$provider" == factory-openai ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER must be factory-openai when FACTORY_PROVIDER_ADAPTER=openai")
      [[ "$base_url" == "$DEFAULT_OPENAI_BASE_URL" ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must be $DEFAULT_OPENAI_BASE_URL when FACTORY_PROVIDER_ADAPTER=openai")
      value_is_blank "$scoped_api_key" && PROVIDER_CONFIG_ERRORS+=("OPENAI_API_KEY is required when FACTORY_PROVIDER_ADAPTER=openai")
    fi
  elif [[ "$adapter" == claude ]]; then
    provider=$(configured_value FACTORY_MODEL_PROVIDER)
    base_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
    model=$(configured_value FACTORY_MODEL)
    authentication=$(configured_value FACTORY_PROVIDER_AUTH)
    api_key=$(configured_value ANTHROPIC_API_KEY)
    bridge_token=$(configured_value FACTORY_PROVIDER_BRIDGE_TOKEN)
    catalog=$(configured_value FACTORY_MODEL_CATALOG_JSON)

    [[ "$provider" == factory-provider ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER must be factory-provider when FACTORY_PROVIDER_ADAPTER=claude")
    [[ "$base_url" == http://claude-provider:10101/v1 ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must be http://claude-provider:10101/v1 when FACTORY_PROVIDER_ADAPTER=claude")
    value_is_blank "$model" && PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL is required when FACTORY_PROVIDER_ADAPTER=claude")
    [[ "$authentication" == bridge ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_AUTH must be bridge when FACTORY_PROVIDER_ADAPTER=claude")
    value_is_blank "$api_key" && PROVIDER_CONFIG_ERRORS+=("ANTHROPIC_API_KEY is required when FACTORY_PROVIDER_ADAPTER=claude")
    value_is_blank "$bridge_token" && PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BRIDGE_TOKEN is required when FACTORY_PROVIDER_ADAPTER=claude")
    value_is_blank "$catalog" || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_CATALOG_JSON must be empty when FACTORY_PROVIDER_ADAPTER=claude")
  elif [[ "$adapter" == zai ]]; then
    provider=$(configured_value FACTORY_MODEL_PROVIDER)
    base_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
    model=$(configured_value FACTORY_MODEL)
    authentication=$(configured_value FACTORY_PROVIDER_AUTH)
    api_key=$(configured_value ZAI_API_KEY)
    bridge_token=$(configured_value FACTORY_PROVIDER_BRIDGE_TOKEN)
    catalog=$(configured_value FACTORY_MODEL_CATALOG_JSON)

    [[ "$provider" == factory-provider ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER must be factory-provider when FACTORY_PROVIDER_ADAPTER=zai")
    [[ "$base_url" == http://zai-provider:10101/v1 ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must be http://zai-provider:10101/v1 when FACTORY_PROVIDER_ADAPTER=zai")
    value_is_blank "$model" && PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL is required when FACTORY_PROVIDER_ADAPTER=zai")
    [[ "$authentication" == bridge ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_AUTH must be bridge when FACTORY_PROVIDER_ADAPTER=zai")
    if value_is_blank "$api_key"; then
      PROVIDER_CONFIG_ERRORS+=("ZAI_API_KEY is required when FACTORY_PROVIDER_ADAPTER=zai")
    fi
    if value_is_blank "$bridge_token"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BRIDGE_TOKEN is required when FACTORY_PROVIDER_ADAPTER=zai")
    fi
    if [[ "$model" == glm-5.2 ]]; then
      [[ "$catalog" == /var/lib/software-factory/provider/codex-models.json ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_CATALOG_JSON must be /var/lib/software-factory/provider/codex-models.json for Z.AI glm-5.2")
    else
      value_is_blank "$catalog" || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_CATALOG_JSON must be empty for custom Z.AI models")
    fi
  elif [[ "$adapter" == deepseek ]]; then
    provider=$(configured_value FACTORY_MODEL_PROVIDER)
    base_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
    model=$(configured_value FACTORY_MODEL)
    authentication=$(configured_value FACTORY_PROVIDER_AUTH)
    api_key=$(configured_value DEEPSEEK_API_KEY)
    bridge_token=$(configured_value FACTORY_PROVIDER_BRIDGE_TOKEN)
    catalog=$(configured_value FACTORY_MODEL_CATALOG_JSON)
    upstream_base_url=$(configured_value FACTORY_DEEPSEEK_BASE_URL)

    [[ "$provider" == factory-provider ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_PROVIDER must be factory-provider when FACTORY_PROVIDER_ADAPTER=deepseek")
    [[ "$base_url" == http://deepseek-provider:10101/v1 ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BASE_URL must be http://deepseek-provider:10101/v1 when FACTORY_PROVIDER_ADAPTER=deepseek")
    if value_is_blank "$model"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL is required when FACTORY_PROVIDER_ADAPTER=deepseek")
    elif [[ "$model" == *$'\n'* || "$model" == *$'\r'* ]]; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL must be a single line")
    fi
    [[ "$authentication" == bridge ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_AUTH must be bridge when FACTORY_PROVIDER_ADAPTER=deepseek")
    if value_is_blank "$api_key"; then
      PROVIDER_CONFIG_ERRORS+=("DEEPSEEK_API_KEY is required when FACTORY_PROVIDER_ADAPTER=deepseek")
    fi
    if value_is_blank "$bridge_token"; then
      PROVIDER_CONFIG_ERRORS+=("FACTORY_PROVIDER_BRIDGE_TOKEN is required when FACTORY_PROVIDER_ADAPTER=deepseek")
    fi
    value_is_blank "$catalog" || PROVIDER_CONFIG_ERRORS+=("FACTORY_MODEL_CATALOG_JSON must be empty when FACTORY_PROVIDER_ADAPTER=deepseek")
    [[ "$upstream_base_url" == "$DEFAULT_DEEPSEEK_BASE_URL" ]] || PROVIDER_CONFIG_ERRORS+=("FACTORY_DEEPSEEK_BASE_URL must be $DEFAULT_DEEPSEEK_BASE_URL when FACTORY_PROVIDER_ADAPTER=deepseek")
  fi

  (( ${#PROVIDER_CONFIG_ERRORS[@]} == 0 ))
}

report_provider_configuration_errors() {
  local error
  printf 'factory: provider configuration is incomplete or invalid:\n' >&2
  for error in "${PROVIDER_CONFIG_ERRORS[@]}"; do
    printf '  - %s\n' "$error" >&2
  done
  printf "Run '%s configure' in a terminal or set the listed variables.\n" "$0" >&2
}

PROMPT_VALUE=''
prompt_value() {
  local label=$1 default=${2-} answer
  if [[ -n "$default" ]]; then
    read -r -p "$label [$default]: " answer || die 'provider configuration cancelled'
    PROMPT_VALUE=${answer:-$default}
  else
    read -r -p "$label: " answer || die 'provider configuration cancelled'
    PROMPT_VALUE=$answer
  fi
}

prompt_secret() {
  local label=$1 current=${2-} answer
  if [[ -n "$current" ]]; then
    read -r -s -p "$label [configured; leave blank to keep]: " answer || die 'provider configuration cancelled'
    PROMPT_VALUE=${answer:-$current}
  else
    read -r -s -p "$label: " answer || die 'provider configuration cancelled'
    PROMPT_VALUE=$answer
  fi
  printf '\n' >&2
}

provider_label() {
  case $1 in
    openai) PROMPT_VALUE='OpenAI' ;;
    claude) PROMPT_VALUE='Anthropic Claude' ;;
    deepseek) PROMPT_VALUE='DeepSeek' ;;
    zai) PROMPT_VALUE='Z.AI' ;;
    responses) PROMPT_VALUE='Custom Responses endpoint' ;;
    *) die "unknown provider: $1" ;;
  esac
}

provider_key_name() {
  case $1 in
    openai) PROMPT_VALUE='OPENAI_API_KEY' ;;
    claude) PROMPT_VALUE='ANTHROPIC_API_KEY' ;;
    deepseek) PROMPT_VALUE='DEEPSEEK_API_KEY' ;;
    zai) PROMPT_VALUE='ZAI_API_KEY' ;;
    *) die "unknown provider: $1" ;;
  esac
}

provider_default_model() {
  case $1 in
    openai) PROMPT_VALUE=$DEFAULT_OPENAI_MODEL ;;
    claude) PROMPT_VALUE=$DEFAULT_CLAUDE_MODEL ;;
    deepseek) PROMPT_VALUE=$DEFAULT_DEEPSEEK_MODEL ;;
    zai) PROMPT_VALUE='glm-5.2' ;;
    *) die "unknown provider: $1" ;;
  esac
}

MODEL_OPTIONS=()
load_model_options() {
  case $1 in
    openai)
      MODEL_OPTIONS=('gpt-5.6-sol' 'gpt-5.6' 'gpt-5.6-terra' 'gpt-5.6-luna')
      ;;
    claude)
      MODEL_OPTIONS=('claude-sonnet-5' 'claude-opus-5' 'claude-fable-5' 'claude-haiku-4-5')
      ;;
    deepseek)
      MODEL_OPTIONS=('deepseek-v4-pro' 'deepseek-v4-flash')
      ;;
    zai)
      MODEL_OPTIONS=('glm-5.2')
      ;;
    *)
      die "unknown provider: $1"
      ;;
  esac
}

list_providers() {
  cat <<'EOF'
Supported providers:
  openai    OpenAI
  claude    Anthropic Claude
  deepseek  DeepSeek
  zai       Z.AI
EOF
}

normalize_provider() {
  case ${1-} in
    1 | openai | OpenAI) PROMPT_VALUE='openai' ;;
    2 | claude | Claude | anthropic | Anthropic) PROMPT_VALUE='claude' ;;
    3 | deepseek | DeepSeek) PROMPT_VALUE='deepseek' ;;
    4 | zai | ZAI | z.ai | Z.AI) PROMPT_VALUE='zai' ;;
    *) return 1 ;;
  esac
}

prompt_provider_selection() {
  local current=${1-} answer default_provider
  default_provider=$current
  normalize_provider "$default_provider" >/dev/null 2>&1 || default_provider='openai'

  printf 'Choose a provider:\n' >&2
  printf '  1) OpenAI\n' >&2
  printf '  2) Anthropic Claude\n' >&2
  printf '  3) DeepSeek\n' >&2
  printf '  4) Z.AI\n' >&2
  read -r -p "Provider [$default_provider]: " answer || die 'provider configuration cancelled'
  answer=${answer:-$default_provider}
  normalize_provider "$answer" || die 'choose OpenAI, Claude, DeepSeek, or Z.AI'
}

list_models() {
  local provider=$1 model
  load_model_options "$provider"
  provider_label "$provider"
  printf '%s models:\n' "$PROMPT_VALUE"
  for model in "${MODEL_OPTIONS[@]}"; do
    printf '  %s\n' "$model"
  done
  printf '  custom model ID\n'
}

prompt_model_selection() {
  local provider=$1 current=${2-} answer choice index custom_index model
  load_model_options "$provider"
  if value_is_blank "$current"; then
    provider_default_model "$provider"
    current=$PROMPT_VALUE
  fi

  printf 'Choose a model:\n' >&2
  index=1
  for model in "${MODEL_OPTIONS[@]}"; do
    printf '  %d) %s\n' "$index" "$model" >&2
    index=$((index + 1))
  done
  custom_index=$index
  printf '  %d) Custom model ID\n' "$custom_index" >&2
  read -r -p "Model [$current]: " answer || die 'provider configuration cancelled'
  if value_is_blank "$answer"; then
    PROMPT_VALUE=$current
    return
  fi
  case $answer in
    *[!0-9]*)
      PROMPT_VALUE=$answer
      return
      ;;
  esac
  choice=$((10#$answer))
  if (( choice >= 1 && choice < custom_index )); then
    PROMPT_VALUE=${MODEL_OPTIONS[$((choice - 1))]}
  elif (( choice == custom_index )); then
    prompt_value 'Model ID'
    value_is_blank "$PROMPT_VALUE" && die 'model ID is required'
  else
    die 'choose one of the listed models'
  fi
}

prompt_zai_endpoint() {
  local current=${1:-$DEFAULT_ZAI_BASE_URL} answer default_choice=2
  [[ "$current" == 'https://api.z.ai/api/coding/paas/v4' ]] && default_choice=1
  printf 'Choose your Z.AI plan:\n' >&2
  printf '  1) Coding Developer Plan\n' >&2
  printf '  2) Standard API\n' >&2
  read -r -p "Plan [$default_choice]: " answer || die 'provider configuration cancelled'
  answer=${answer:-$default_choice}
  case $answer in
    1 | coding | Coding) PROMPT_VALUE='https://api.z.ai/api/coding/paas/v4' ;;
    2 | standard | Standard) PROMPT_VALUE=$DEFAULT_ZAI_BASE_URL ;;
    *) die 'choose Coding Developer Plan or Standard API' ;;
  esac
}

persist_named_provider() {
  local provider=$1 requested_model=${2-}
  local current_provider current_model key_name api_key model label bridge_token upstream_base_url
  current_provider=$(configured_value FACTORY_PROVIDER_ADAPTER)
  current_model=''
  [[ "$current_provider" == "$provider" ]] && current_model=$(configured_value FACTORY_MODEL)

  provider_key_name "$provider"
  key_name=$PROMPT_VALUE
  api_key=$(configured_value "$key_name")
  provider_label "$provider"
  label=$PROMPT_VALUE

  if [[ -t 0 && -t 2 ]]; then
    prompt_secret "$label API key" "$api_key"
    api_key=$PROMPT_VALUE
  elif value_is_blank "$api_key"; then
    PROVIDER_CONFIG_ERRORS=("$key_name is required to configure $label")
    report_provider_configuration_errors
    return 1
  fi
  value_is_blank "$api_key" && die "$label API key is required"

  if value_is_blank "$requested_model"; then
    if [[ -t 0 && -t 2 ]]; then
      prompt_model_selection "$provider" "$current_model"
      model=$PROMPT_VALUE
    elif ! value_is_blank "$current_model"; then
      model=$current_model
    else
      provider_default_model "$provider"
      model=$PROMPT_VALUE
    fi
  else
    model=$requested_model
  fi
  [[ "$model" != *$'\n'* && "$model" != *$'\r'* ]] || die 'model ID must be a single line'

  write_env_value "$key_name" "$api_key"
  write_env_value FACTORY_MODEL "$model"
  write_env_value FACTORY_PROVIDER_AUTH_TOKEN ''

  if [[ "$provider" == openai ]]; then
    write_env_value FACTORY_PROVIDER_ADAPTER openai
    write_env_value FACTORY_MODEL_PROVIDER factory-openai
    write_env_value FACTORY_PROVIDER_NAME OpenAI
    write_env_value FACTORY_PROVIDER_BASE_URL "$DEFAULT_OPENAI_BASE_URL"
    write_env_value FACTORY_PROVIDER_AUTH key
    write_env_value FACTORY_PROVIDER_API_KEY "$api_key"
    write_env_value FACTORY_MODEL_CATALOG_JSON ''
    return
  fi

  bridge_token=$(configured_value FACTORY_PROVIDER_BRIDGE_TOKEN)
  value_is_blank "$bridge_token" && bridge_token=$(generate_bridge_token)
  write_env_value FACTORY_PROVIDER_ADAPTER "$provider"
  write_env_value FACTORY_MODEL_PROVIDER factory-provider
  write_env_value FACTORY_PROVIDER_AUTH bridge
  write_env_value FACTORY_PROVIDER_API_KEY ''
  write_env_value FACTORY_PROVIDER_BRIDGE_TOKEN "$bridge_token"

  case $provider in
    claude)
      write_env_value FACTORY_PROVIDER_NAME 'Anthropic Claude provider'
      write_env_value FACTORY_PROVIDER_BASE_URL http://claude-provider:10101/v1
      write_env_value FACTORY_MODEL_CATALOG_JSON ''
      ;;
    deepseek)
      write_env_value FACTORY_PROVIDER_NAME 'DeepSeek provider'
      write_env_value FACTORY_PROVIDER_BASE_URL http://deepseek-provider:10101/v1
      write_env_value FACTORY_MODEL_CATALOG_JSON ''
      write_env_value FACTORY_DEEPSEEK_BASE_URL "$DEFAULT_DEEPSEEK_BASE_URL"
      ;;
    zai)
      upstream_base_url=$(configured_value FACTORY_ZAI_BASE_URL)
      value_is_blank "$upstream_base_url" && upstream_base_url=$DEFAULT_ZAI_BASE_URL
      if [[ -t 0 && -t 2 ]]; then
        prompt_zai_endpoint "$upstream_base_url"
        upstream_base_url=$PROMPT_VALUE
      fi
      write_env_value FACTORY_PROVIDER_NAME 'Z.AI GLM provider'
      write_env_value FACTORY_PROVIDER_BASE_URL http://zai-provider:10101/v1
      if [[ "$model" == glm-5.2 ]]; then
        write_env_value FACTORY_MODEL_CATALOG_JSON /var/lib/software-factory/provider/codex-models.json
      else
        write_env_value FACTORY_MODEL_CATALOG_JSON ''
      fi
      write_env_value FACTORY_ZAI_BASE_URL "$upstream_base_url"
      ;;
  esac
}

persist_responses_configuration() {
  local provider base_url model authentication api_key
  local current_adapter
  current_adapter=$(configured_value FACTORY_PROVIDER_ADAPTER)
  if [[ "$current_adapter" == responses ]]; then
    provider=$(configured_value FACTORY_MODEL_PROVIDER)
    base_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
    model=$(configured_value FACTORY_MODEL)
    authentication=$(configured_value FACTORY_PROVIDER_AUTH)
    api_key=$(configured_value FACTORY_PROVIDER_API_KEY)
  else
    provider=''
    base_url=''
    model=''
    authentication=''
    api_key=''
  fi

  if [[ -t 0 && -t 2 ]]; then
    prompt_value 'Provider ID' "${provider:-configured-provider}"
    provider=$PROMPT_VALUE
    prompt_value 'Responses API base URL' "$base_url"
    base_url=$PROMPT_VALUE
    prompt_value 'Model' "$model"
    model=$PROMPT_VALUE
    prompt_value 'Authentication (key|none)' "${authentication:-key}"
    authentication=$PROMPT_VALUE
    if [[ "$authentication" == key ]]; then
      prompt_secret 'Provider API key' "$api_key"
      api_key=$PROMPT_VALUE
    else
      api_key=''
    fi
  fi

  write_env_value FACTORY_PROVIDER_ADAPTER responses
  write_env_value FACTORY_MODEL_PROVIDER "$provider"
  write_env_value FACTORY_PROVIDER_BASE_URL "$base_url"
  write_env_value FACTORY_MODEL "$model"
  write_env_value FACTORY_PROVIDER_AUTH "$authentication"
  write_env_value FACTORY_PROVIDER_API_KEY "$api_key"
  write_env_value FACTORY_PROVIDER_NAME 'Software Factory deployment provider'
  write_env_value FACTORY_MODEL_CATALOG_JSON ''
  write_env_value FACTORY_PROVIDER_BRIDGE_TOKEN ''
  write_env_value FACTORY_PROVIDER_AUTH_TOKEN ''
}

generate_bridge_token() {
  LC_ALL=C od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
}

persist_zai_preset() {
  persist_named_provider zai 'glm-5.2'
}

persist_deepseek_preset() {
  persist_named_provider deepseek "$DEFAULT_DEEPSEEK_MODEL"
}

resolve_provider_environment() {
  local adapter file_adapter
  adapter=$(configured_value FACTORY_PROVIDER_ADAPTER)

  if [[ "$adapter" == responses || "$adapter" == openai ]]; then
    file_adapter=$(env_file_value FACTORY_PROVIDER_ADAPTER)
    if declare -p FACTORY_PROVIDER_ADAPTER >/dev/null 2>&1 &&
      [[ "$file_adapter" != responses ]]; then
      if ! declare -p FACTORY_PROVIDER_NAME >/dev/null 2>&1; then
        export FACTORY_PROVIDER_NAME='Software Factory deployment provider'
      fi
      if ! declare -p FACTORY_MODEL_CATALOG_JSON >/dev/null 2>&1; then
        export FACTORY_MODEL_CATALOG_JSON=''
      fi
    fi
    export FACTORY_PROVIDER_BRIDGE_TOKEN=''
    export FACTORY_PROVIDER_AUTH_TOKEN=''
    export ANTHROPIC_API_KEY=''
    export ZAI_API_KEY=''
    export DEEPSEEK_API_KEY=''
  elif [[ "$adapter" == claude ]]; then
    export FACTORY_PROVIDER_API_KEY=''
    export FACTORY_PROVIDER_AUTH_TOKEN=''
    export OPENAI_API_KEY=''
    export ZAI_API_KEY=''
    export DEEPSEEK_API_KEY=''
  elif [[ "$adapter" == zai ]]; then
    export FACTORY_PROVIDER_API_KEY=''
    export FACTORY_PROVIDER_AUTH_TOKEN=''
    export OPENAI_API_KEY=''
    export ANTHROPIC_API_KEY=''
    export DEEPSEEK_API_KEY=''
  elif [[ "$adapter" == deepseek ]]; then
    export FACTORY_PROVIDER_API_KEY=''
    export FACTORY_PROVIDER_AUTH_TOKEN=''
    export OPENAI_API_KEY=''
    export ANTHROPIC_API_KEY=''
    export ZAI_API_KEY=''
  fi
}

show_provider_configuration() {
  local adapter authentication provider provider_name provider_url model catalog provider_key bridge_key
  resolve_provider_environment
  adapter=$(configured_value FACTORY_PROVIDER_ADAPTER)
  authentication=$(configured_value FACTORY_PROVIDER_AUTH)
  provider=$(configured_value FACTORY_MODEL_PROVIDER)
  provider_name=$(configured_value FACTORY_PROVIDER_NAME)
  provider_url=$(configured_value FACTORY_PROVIDER_BASE_URL)
  model=$(configured_value FACTORY_MODEL)
  catalog=$(configured_value FACTORY_MODEL_CATALOG_JSON)
  provider_key=$(configured_value FACTORY_PROVIDER_API_KEY)
  bridge_key=$(configured_value FACTORY_PROVIDER_BRIDGE_TOKEN)

  printf 'Active provider configuration:\n'
  printf '  adapter: %s\n' "${adapter:-<unset>}"
  printf '  provider ID: %s\n' "${provider:-<unset>}"
  printf '  provider name: %s\n' "${provider_name:-<default>}"
  printf '  base URL: %s\n' "${provider_url:-<unset>}"
  printf '  model: %s\n' "${model:-<unset>}"
  printf '  model catalog: %s\n' "${catalog:-<none>}"
  printf '  authentication: %s\n' "${authentication:-<unset>}"
  if [[ "$adapter" == claude ]]; then
    printf '  provider API key: %s\n' "$([[ -n "$(configured_value ANTHROPIC_API_KEY)" ]] && printf set || printf unset)"
    printf '  bridge token: %s\n' "$([[ -n "$bridge_key" ]] && printf set || printf unset)"
  elif [[ "$adapter" == zai ]]; then
    printf '  provider API key: %s\n' "$([[ -n "$(configured_value ZAI_API_KEY)" ]] && printf set || printf unset)"
    printf '  bridge token: %s\n' "$([[ -n "$bridge_key" ]] && printf set || printf unset)"
  elif [[ "$adapter" == deepseek ]]; then
    printf '  provider API key: %s\n' "$([[ -n "$(configured_value DEEPSEEK_API_KEY)" ]] && printf set || printf unset)"
    printf '  bridge token: %s\n' "$([[ -n "$bridge_key" ]] && printf set || printf unset)"
  elif [[ "$adapter" == openai ]]; then
    printf '  provider API key: %s\n' "$([[ -n "$(configured_value OPENAI_API_KEY)" ]] && printf set || printf unset)"
  else
    printf '  provider API key: %s\n' "$([[ -n "$provider_key" ]] && printf set || printf unset)"
  fi
}

configure_command() {
  local provider model=''
  ensure_env_file
  case ${1-} in
    '')
      (( $# == 0 )) || die 'usage: factory configure [--show | --provider <name> [--model <id>] | --custom]'
      [[ -t 0 && -t 2 ]] || die 'factory configure requires a terminal; use factory provider <name> with its API key environment variable'
      prompt_provider_selection "$(configured_value FACTORY_PROVIDER_ADAPTER)"
      persist_named_provider "$PROMPT_VALUE"
      ;;
    --show)
      (( $# == 1 )) || die 'usage: factory configure --show'
      show_provider_configuration
      return
      ;;
    --preset)
      [[ $# == 2 ]] || die 'usage: factory configure --preset <zai|deepseek>'
      case ${2-} in
        zai) persist_zai_preset ;;
        deepseek) persist_deepseek_preset ;;
        *) die 'usage: factory configure --preset <zai|deepseek>' ;;
      esac
      ;;
    --provider)
      (( $# == 2 || $# == 4 )) || die 'usage: factory configure --provider <openai|claude|deepseek|zai> [--model <id>]'
      normalize_provider "${2-}" || die 'provider must be openai, claude, deepseek, or zai'
      provider=$PROMPT_VALUE
      if (( $# == 4 )); then
        [[ ${3-} == --model && -n ${4-} ]] || die 'usage: factory configure --provider <name> [--model <id>]'
        model=$4
      fi
      persist_named_provider "$provider" "$model"
      ;;
    --custom)
      (( $# == 1 )) || die 'usage: factory configure --custom'
      persist_responses_configuration
      ;;
    *)
      die 'usage: factory configure [--show | --provider <name> [--model <id>] | --custom]'
      ;;
  esac

  if ! validate_provider_configuration; then
    report_provider_configuration_errors
    return 1
  fi
  provider=$(configured_value FACTORY_PROVIDER_ADAPTER)
  provider_label "$provider"
  printf 'Configured %s with model %s.\n' "$PROMPT_VALUE" "$(configured_value FACTORY_MODEL)"
}

ensure_provider_configuration() {
  if validate_provider_configuration; then
    return
  fi
  if [[ -t 0 && -t 2 ]]; then
    printf 'Welcome to Software Factory.\n' >&2
    prompt_provider_selection
    persist_named_provider "$PROMPT_VALUE"
    if validate_provider_configuration; then
      printf 'Provider configured.\n' >&2
      return
    fi
  fi
  report_provider_configuration_errors
  return 1
}

provider_command() {
  local provider model=''
  ensure_env_file
  case ${1-} in
    list)
      (( $# == 1 )) || die 'usage: factory provider list'
      list_providers
      return
      ;;
    show)
      (( $# == 1 )) || die 'usage: factory provider show'
      show_provider_configuration
      return
      ;;
    '')
      (( $# == 0 )) || die 'usage: factory provider [list|show|<name> [--model <id>]]'
      [[ -t 0 && -t 2 ]] || die 'provider name is required without a terminal'
      prompt_provider_selection "$(configured_value FACTORY_PROVIDER_ADAPTER)"
      provider=$PROMPT_VALUE
      ;;
    *)
      normalize_provider "$1" || die 'provider must be openai, claude, deepseek, or zai'
      provider=$PROMPT_VALUE
      shift
      if (( $# > 0 )); then
        [[ $# == 2 && $1 == --model && -n ${2-} ]] || die 'usage: factory provider <name> [--model <id>]'
        model=$2
      fi
      ;;
  esac
  persist_named_provider "$provider" "$model"
  validate_provider_configuration || {
    report_provider_configuration_errors
    return 1
  }
  provider_label "$provider"
  printf 'Now using %s with model %s.\n' "$PROMPT_VALUE" "$(configured_value FACTORY_MODEL)"
}

model_command() {
  local provider model
  ensure_env_file
  validate_provider_configuration || {
    report_provider_configuration_errors
    return 1
  }
  provider=$(configured_value FACTORY_PROVIDER_ADAPTER)
  [[ "$provider" != responses ]] || die 'use `factory configure --custom` to change a custom Responses model'

  case ${1-} in
    list)
      (( $# == 1 )) || die 'usage: factory model list'
      list_models "$provider"
      return
      ;;
    '')
      (( $# == 0 )) || die 'usage: factory model [list|<model-id>]'
      [[ -t 0 && -t 2 ]] || die 'model ID is required without a terminal'
      prompt_model_selection "$provider" "$(configured_value FACTORY_MODEL)"
      model=$PROMPT_VALUE
      ;;
    *)
      (( $# == 1 )) || die 'usage: factory model [list|<model-id>]'
      model=$1
      ;;
  esac

  value_is_blank "$model" && die 'model ID is required'
  [[ "$model" != *$'\n'* && "$model" != *$'\r'* ]] || die 'model ID must be a single line'
  write_env_value FACTORY_MODEL "$model"
  if [[ "$provider" == zai && "$model" == glm-5.2 ]]; then
    write_env_value FACTORY_MODEL_CATALOG_JSON /var/lib/software-factory/provider/codex-models.json
  elif [[ "$provider" == zai ]]; then
    write_env_value FACTORY_MODEL_CATALOG_JSON ''
  fi
  validate_provider_configuration || {
    report_provider_configuration_errors
    return 1
  }
  printf 'Now using model %s.\n' "$model"
}

compose() {
  "${COMPOSE[@]}" "$@"
}

pull_factory_image() {
  local image
  image=$(configured_value FACTORY_IMAGE)
  value_is_blank "$image" && image=$DEFAULT_FACTORY_IMAGE
  [[ "$image" == software-factory:local ]] && return
  printf 'Pulling Factory image %s\n' "$image" >&2
  compose pull factoryd >&2
}

reconcile_provider_services() {
  local provider_adapter=$1
  local inactive_services=()

  [[ "$provider_adapter" == claude ]] || inactive_services+=(claude-provider)
  [[ "$provider_adapter" == zai ]] || inactive_services+=(zai-provider)
  [[ "$provider_adapter" == deepseek ]] || inactive_services+=(deepseek-provider)
  (( ${#inactive_services[@]} == 0 )) ||
    compose --profile claude --profile zai --profile deepseek rm --stop --force "${inactive_services[@]}" >/dev/null
}

bootstrap_hatchet_token() {
  local token output attempt first rest second third extra
  token=$(configured_value HATCHET_CLIENT_TOKEN)
  [[ -n "$token" ]] && return

  for (( attempt = 1; attempt <= 60; attempt++ )); do
    if output=$(compose exec -T hatchet \
      ./hatchet-admin token create \
      --config ./config \
      --tenant-id "$HATCHET_TENANT_ID" \
      --expiresIn 876000h0m0s \
      --name software-factory-cli 2>/dev/null); then
      token=${output//$'\r'/}
      token=${token//$'\n'/}
      IFS=. read -r first second third extra <<< "$token"
      if [[ -n "$first" && -n "$second" && -n "$third" && -z "${extra:-}" &&
            "$token" != *[[:space:]]* ]]; then
        break
      fi
      token=''
    fi
    sleep 2
  done

  [[ -n "$token" ]] || die 'Hatchet did not become ready in time'
  write_env_value HATCHET_CLIENT_TOKEN "$token"
  export HATCHET_CLIENT_TOKEN=$token
}

up_stack() {
  local profile=()
  local services=(postgres hatchet qdrant factoryd)
  local provider_adapter
  ensure_env_file
  ensure_provider_configuration
  provider_adapter=$(configured_value FACTORY_PROVIDER_ADAPTER)
  resolve_provider_environment
  require_docker
  pull_factory_image
  reconcile_provider_services "$provider_adapter"
  if [[ "$provider_adapter" == claude ]]; then
    profile=(--profile claude)
    services+=(claude-provider)
  elif [[ "$provider_adapter" == zai ]]; then
    profile=(--profile zai)
    services+=(zai-provider)
  elif [[ "$provider_adapter" == deepseek ]]; then
    profile=(--profile deepseek)
    services+=(deepseek-provider)
  fi

  compose "${profile[@]}" up -d --wait --wait-timeout 180 \
    "${services[@]}"
  bootstrap_hatchet_token
  guard_project_mount
  compose "${profile[@]}" up -d --wait --wait-timeout 180 workflow-worker
  printf 'Factory is ready for %s\n' "$PROJECT_DIR" >&2
}

run_command() {
  local detach=0 task
  if [[ ${1-} == --detach ]]; then
    detach=1
    shift
  fi
  (( $# <= 1 )) || die 'quote the task as one argument: factory run "your task"'
  task=${1-}
  if value_is_blank "$task"; then
    if [[ -t 0 && -t 2 ]]; then
      ensure_env_file
      ensure_provider_configuration
      prompt_value 'Task'
      task=$PROMPT_VALUE
    else
      die 'a task is required: factory run [--detach] "your task"'
    fi
  fi
  value_is_blank "$task" && die 'task cannot be empty'

  up_stack
  if (( detach == 1 )); then
    exec_run_cli run --detach "$task"
  else
    exec_run_cli run "$task"
  fi
}

require_service() {
  local service=$1 container_id
  container_id=$(compose ps --status running --quiet "$service" 2>/dev/null || true)
  [[ -n "$container_id" ]] || die "$service is not running; run '$0 up' first"
}

exec_run_cli() {
  local tty=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  require_service workflow-worker

  exec "${COMPOSE[@]}" exec "${tty[@]}" \
    --user "$HOST_UID:$HOST_GID" \
    --workdir /workspace/project \
    --env HOME=/var/lib/software-factory/codex \
    --env XDG_CACHE_HOME=/var/lib/software-factory/codex/.cache \
    --env FACTORY_PROJECT_ID="$PROJECT_DIR" \
    workflow-worker node /opt/software-factory/workflows/dist/cli.js "$@"
}

exec_control_cli() {
  local tty=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  require_service factoryd

  exec "${COMPOSE[@]}" exec "${tty[@]}" \
    --user "$HOST_UID:$HOST_GID" \
    --workdir /opt/software-factory/workflows \
    --env FACTORYD_URL=http://127.0.0.1:8787/v1 \
    factoryd node /opt/software-factory/workflows/dist/cli.js "$@"
}

guard_project_mount() {
  require_service factoryd
  compose exec -T \
    --user "$HOST_UID:$HOST_GID" \
    --workdir /opt/software-factory/workflows \
    --env FACTORYD_URL=http://127.0.0.1:8787/v1 \
    factoryd node /opt/software-factory/workflows/dist/cli.js \
    guard-project "$PROJECT_DIR"
}

main() {
  local command
  if (( $# == 0 )); then
    [[ -t 0 && -t 2 ]] || die 'a task is required: factory run --detach "your task"'
    run_command
    return
  fi
  command=$1
  shift

  case "$command" in
    help | --help | -h)
      usage
      ;;
    run)
      run_command "$@"
      ;;
    configure)
      configure_command "$@"
      ;;
    provider)
      provider_command "$@"
      ;;
    model)
      model_command "$@"
      ;;
    attach | status | stop)
      ensure_env_file
      require_docker
      exec_control_cli "$command" "$@"
      ;;
    logs)
      (( $# == 0 )) || die 'usage: factory logs'
      ensure_env_file
      require_docker
      compose logs --follow factoryd workflow-worker
      ;;
    up)
      (( $# == 0 )) || die 'usage: factory up'
      up_stack
      ;;
    down)
      (( $# == 0 )) || die 'usage: factory down'
      ensure_env_file
      require_docker
      compose --profile '*' down --remove-orphans
      ;;
    build)
      (( $# == 0 )) || die 'usage: factory build'
      ensure_env_file
      require_docker
      [[ -f "$BUILD_COMPOSE_FILE" ]] || die "missing $BUILD_COMPOSE_FILE"
      FACTORY_IMAGE=software-factory:local \
        FACTORY_BUILD_JOBS=${FACTORY_BUILD_JOBS:-2} \
        "${COMPOSE[@]}" --file "$BUILD_COMPOSE_FILE" build workflow-worker
      ;;
    install)
      (( $# == 0 )) || die 'usage: factory install'
      install_cli
      ;;
    *)
      printf 'factory: unknown command: %s\n\n' "$command" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
