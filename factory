#!/usr/bin/env bash
set -euo pipefail

readonly FACTORY_PROJECT_NAME='software-factory'
readonly HATCHET_TENANT_ID='707d0855-80ab-4e1f-a156-f1c4546cbf52'
readonly DEFAULT_FACTORY_IMAGE='ghcr.io/fpolica91/software-factory:edge'
readonly DEFAULT_OPENAI_BASE_URL='https://api.openai.com/v1'
readonly DEFAULT_OPENAI_MODEL='gpt-5.6-sol'
readonly DEFAULT_CLAUDE_BASE_URL='https://api.anthropic.com'
readonly DEFAULT_CLAUDE_MODEL='claude-sonnet-5'
readonly DEFAULT_ZAI_BASE_URL='https://api.z.ai/api/paas/v4'
readonly DEFAULT_DEEPSEEK_BASE_URL='https://api.deepseek.com'
readonly DEFAULT_DEEPSEEK_MODEL='deepseek-v4-pro'

resolve_product_root() {
  local source_path=${BASH_SOURCE[0]}
  local source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
    link_target=$(readlink "$source_path")
    if [[ "$link_target" == /* ]]; then
      source_path=$link_target
    else
      source_path=$source_dir/$link_target
    fi
  done

  cd -P "$(dirname "$source_path")" && pwd
}

find_project_dir() {
  local start current parent git_root
  start=$(pwd -P)

  if command -v git >/dev/null 2>&1; then
    if git_root=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null); then
      cd -P "$git_root" && pwd
      return
    fi
  fi

  current=$start
  while :; do
    if [[ -e "$current/.git" ]]; then
      printf '%s\n' "$current"
      return
    fi
    [[ "$current" == / ]] && break
    parent=${current%/*}
    [[ -n "$parent" ]] || parent=/
    current=$parent
  done

  printf '%s\n' "$start"
}

readonly PRODUCT_ROOT=$(resolve_product_root)
readonly COMPOSE_FILE=$PRODUCT_ROOT/docker-compose.yml
readonly BUILD_COMPOSE_FILE=$PRODUCT_ROOT/docker-compose.build.yml
readonly ENV_FILE=$PRODUCT_ROOT/.env
readonly ENV_EXAMPLE=$PRODUCT_ROOT/.env.example
readonly PROJECT_DIR=$(find_project_dir)
readonly HOST_UID=$(id -u)
readonly HOST_GID=$(id -g)

export FACTORY_PROJECT_DIR=$PROJECT_DIR
export FACTORY_RUN_AS_UID=$HOST_UID
export FACTORY_RUN_AS_GID=$HOST_GID

COMPOSE=(
  docker compose
  --project-directory "$PRODUCT_ROOT"
  --env-file "$ENV_FILE"
  --file "$COMPOSE_FILE"
  --project-name "$FACTORY_PROJECT_NAME"
)

die() {
  printf 'factory: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Software Factory CLI

Usage:
  factory                         Onboard if needed, then ask what Factory should do
  factory run [--detach] [task]   Run a task against the current Git repository
  factory configure              Choose provider, API key, and model
