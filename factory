#!/usr/bin/env bash
set -euo pipefail

readonly FACTORY_PROJECT_NAME=${FACTORY_PROJECT_NAME:-software-factory}
readonly DEFAULT_FACTORY_IMAGE='ghcr.io/fpolica91/software-factory:edge'

resolve_product_root() {
  local source_path=${BASH_SOURCE[0]} source_dir link_target
  while [[ -L "$source_path" ]]; do
    source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
    link_target=$(readlink "$source_path")
    if [[ "$link_target" == /* ]]; then
      source_path=$link_target
    else
      source_path=$source_dir/$link_target
    fi
  done
  cd -P "$(dirname "$source_path")" && pwd
}

find_project_dir() {
  local start git_root
  start=$(pwd -P)
  if command -v git >/dev/null 2>&1 &&
    git_root=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null); then
    cd -P "$git_root" && pwd
  else
    printf '%s\n' "$start"
  fi
}

sha256_text() {
  local value=$1
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$value" | shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$value" | sha256sum | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    printf '%s' "$value" | openssl dgst -sha256 -r | awk '{print $1}'
  else
    printf '%s\n' 'factory: shasum, sha256sum, or openssl is required to identify the host repository' >&2
    return 1
  fi
}

readonly PRODUCT_ROOT=$(resolve_product_root)
readonly COMPOSE_FILE=$PRODUCT_ROOT/docker-compose.yml
readonly KUBERNETES_COMPOSE_FILE=$PRODUCT_ROOT/docker-compose.kubernetes.yml
readonly KUBERNETES_WORKSPACE_TEMPLATE=$PRODUCT_ROOT/deploy/k3s/single-node-workspaces.yaml
readonly BACKEND_MARKER=$PRODUCT_ROOT/.factory-execution-backend
readonly ENV_FILE=$PRODUCT_ROOT/.env
readonly ENV_EXAMPLE=$PRODUCT_ROOT/.env.example
readonly PROJECT_DIR=$(find_project_dir)
readonly HOST_REPOSITORY_ID="local:$(sha256_text "$PROJECT_DIR")"
readonly HOST_ARTIFACT_DIR=$PROJECT_DIR/.factory
readonly HOST_UID=$(id -u)
readonly HOST_GID=$(id -g)

export FACTORY_PROJECT_DIR=$PROJECT_DIR
export FACTORY_ARTIFACT_HOST_DIR=$HOST_ARTIFACT_DIR
export FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID
export FACTORY_RUN_AS_UID=$HOST_UID
export FACTORY_RUN_AS_GID=$HOST_GID

BASE_COMPOSE=(
  docker compose
  --project-directory "$PRODUCT_ROOT"
  --env-file "$ENV_FILE"
  --file "$COMPOSE_FILE"
  --project-name "$FACTORY_PROJECT_NAME"
)
COMPOSE=("${BASE_COMPOSE[@]}")
EXECUTION_BACKEND=''
KUBECTL=()
KUBERNETES_PREFLIGHTED=0
KUBERNETES_WORKSPACE_MODE=''
KUBERNETES_NODE_NAME=''
KUBERNETES_EXECUTION_NODE_NAME=''
KUBERNETES_SCHEDULABLE_NODE_COUNT=''
KUBERNETES_WORKSPACE_HOST_DIR=''
KUBERNETES_NAMESPACE=''
KUBERNETES_WORKSPACE_PVC=''
KUBERNETES_WORKSPACE_PV=''
KUBERNETES_WORKSPACE_SIZE_GIB=''
KUBERNETES_RUNTIME_CLASS=''
KUBERNETES_RUNTIME_HANDLER=''
KUBERNETES_GPU_RESOURCE=''
KUBERNETES_GPU_COUNT='0'

die() {
  printf 'factory: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Software Factory

Usage:
  factory [task]                    Onboard if needed, then run a durable task
  factory run [--detach] [task...]  Start and optionally detach from a task
  factory run --no-apply [task...]  Keep the result for explicit apply/export
  factory run --repository URL ...  Run against a remote Git URL
  factory configure [options]       Configure provider, API key, endpoint, model
  factory configure --show          Show configuration without displaying keys
  factory provider [list|show|name] List, inspect, or switch providers
  factory model [list|model-id]      List or switch models
  factory continue <job-id> [text]   Reopen a succeeded job with follow-up feedback
  factory attach <job-id>            Reattach with compact expandable output
  factory attach --verbose <job-id>  Replay every durable event in full
  factory status <job-id>            Show durable job and stage status
  factory result <job-id>            Print the complete durable result
  factory artifacts <job-id>         List fixed job artifacts and location
  factory stop <job-id>              Cancel a durable job
  factory apply <job-id>             Apply a result to this clean checkout
  factory export <job-id> [-o FILE]  Export a standard binary Git patch
  factory logs                       Follow worker, coordinator, and provider logs
  factory up                         Start the local Factory stack
  factory down                       Stop the stack while preserving data
  factory build                      Build the Rust image locally
  factory install                    Install this launcher in ~/.local/bin
  factory help                       Show this help

Provider automation uses the provider-specific key environment variable:
OPENAI_API_KEY, ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, or ZAI_API_KEY.
EOF
}

ensure_env_file() {
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_EXAMPLE" ]] || die "missing $ENV_EXAMPLE"
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
}

ensure_artifact_root() {
  local exclude_path exclude_parent
  mkdir -p "$HOST_ARTIFACT_DIR/jobs"

  if ! exclude_path=$(git -C "$PROJECT_DIR" rev-parse --git-path info/exclude 2>/dev/null); then
    return
  fi
  if [[ "$exclude_path" != /* ]]; then
    exclude_path=$PROJECT_DIR/$exclude_path
  fi
  exclude_parent=$(dirname -- "$exclude_path")
  mkdir -p "$exclude_parent"
  touch "$exclude_path"
  if ! grep -Fqx '/.factory/' "$exclude_path"; then
    printf '\n/.factory/\n' >> "$exclude_path"
  fi
}

compose() {
  "${COMPOSE[@]}" "$@"
}

base_compose_environment_value() {
  local key=$1 environment line value=''
  environment=$("${BASE_COMPOSE[@]}" config --environment) ||
    die "cannot read Compose environment from $ENV_FILE"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      value=${line#*=}
    fi
  done <<< "$environment"
  printf '%s' "$value"
}

select_execution_backend() {
  local backend workspace_mode workspace_host_dir kubeconfig namespace pvc pv slug
  [[ -z "$EXECUTION_BACKEND" ]] || return
  validate_factory_project_name
  backend=$(base_compose_environment_value FACTORY_EXECUTION_ENVIRONMENT_BACKEND)
  backend=${backend:-docker}
  case "$backend" in
    docker)
      EXECUTION_BACKEND=docker
      ;;
    kubernetes)
      [[ -f "$KUBERNETES_COMPOSE_FILE" ]] || die "missing $KUBERNETES_COMPOSE_FILE"
      workspace_mode=$(base_compose_environment_value FACTORY_KUBERNETES_WORKSPACE_MODE)
      workspace_mode=${workspace_mode:-local}
      case "$workspace_mode" in
        local | existing-pvc) ;;
        *) die 'FACTORY_KUBERNETES_WORKSPACE_MODE must be local or existing-pvc' ;;
      esac
      workspace_host_dir=$(base_compose_environment_value FACTORY_KUBERNETES_WORKSPACE_HOST_DIR)
      if [[ "$workspace_mode" == existing-pvc && -z "$workspace_host_dir" ]]; then
        die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR is required when FACTORY_KUBERNETES_WORKSPACE_MODE=existing-pvc'
      elif [[ -z "$workspace_host_dir" ]]; then
        workspace_host_dir=${XDG_DATA_HOME:-$HOME/.local/share}/software-factory/$FACTORY_PROJECT_NAME/workspaces
      fi
      validate_workspace_host_path "$workspace_host_dir"
      kubeconfig=$(base_compose_environment_value FACTORY_KUBERNETES_KUBECONFIG)
      kubeconfig=${kubeconfig:-${XDG_CONFIG_HOME:-$HOME/.config}/software-factory/k3s.yaml}
      slug=$(kubernetes_project_slug)
      namespace=$(base_compose_environment_value FACTORY_KUBERNETES_NAMESPACE)
      pvc=$(base_compose_environment_value FACTORY_KUBERNETES_WORKSPACE_PVC)
      pv=$(base_compose_environment_value FACTORY_KUBERNETES_WORKSPACE_PV)
      if [[ "$workspace_mode" == existing-pvc ]]; then
        [[ -n "$namespace" ]] ||
          die 'FACTORY_KUBERNETES_NAMESPACE is required when FACTORY_KUBERNETES_WORKSPACE_MODE=existing-pvc'
        [[ -n "$pvc" ]] ||
          die 'FACTORY_KUBERNETES_WORKSPACE_PVC is required when FACTORY_KUBERNETES_WORKSPACE_MODE=existing-pvc'
        pv=''
      else
        namespace=${namespace:-$slug-execution}
        pvc=${pvc:-$slug-workspaces}
        pv=${pv:-$slug-workspaces-pv}
      fi
      validate_dns_label FACTORY_KUBERNETES_NAMESPACE "$namespace"
      validate_dns_label FACTORY_KUBERNETES_WORKSPACE_PVC "$pvc"
      if [[ "$workspace_mode" == local ]]; then
        validate_dns_label FACTORY_KUBERNETES_WORKSPACE_PV "$pv"
      fi
      KUBERNETES_WORKSPACE_MODE=$workspace_mode
      export FACTORY_KUBERNETES_WORKSPACE_MODE=$workspace_mode
      if [[ "$workspace_mode" == existing-pvc ]]; then
        export FACTORY_WORKSPACE_OWNERSHIP_MODE=preserve
      else
        export FACTORY_WORKSPACE_OWNERSHIP_MODE=manage
      fi
      export FACTORY_KUBERNETES_WORKSPACE_HOST_DIR=$workspace_host_dir
      export FACTORY_KUBERNETES_KUBECONFIG=$kubeconfig
      export FACTORY_KUBERNETES_NAMESPACE=$namespace
      export FACTORY_KUBERNETES_WORKSPACE_PVC=$pvc
      export FACTORY_KUBERNETES_WORKSPACE_PV=$pv
      COMPOSE+=(--file "$KUBERNETES_COMPOSE_FILE")
      EXECUTION_BACKEND=kubernetes
      ;;
    *) die "unsupported FACTORY_EXECUTION_ENVIRONMENT_BACKEND: $backend" ;;
  esac
}

# Docker Compose is the process that expands .env into every service. Reading
# its canonical environment here keeps launcher preflight and per-job pinning
# byte-for-byte aligned with the worker, including quoted literal characters.
compose_environment_value() {
  local key=$1 environment line value=''
  environment=$(compose config --environment) ||
    die "cannot read Compose environment from $ENV_FILE"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      value=${line#*=}
    fi
  done <<< "$environment"
  printf '%s' "$value"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die 'Docker is required'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose is required'
  docker info >/dev/null 2>&1 || die 'Docker is not running'
  [[ -f "$COMPOSE_FILE" ]] || die "missing $COMPOSE_FILE"
}

compose_volume_exists() {
  local volume_name=$1
  docker volume ls --quiet \
    --filter "label=com.docker.compose.project=$FACTORY_PROJECT_NAME" \
    --filter "label=com.docker.compose.volume=$volume_name" | grep -q .
}

read_backend_marker() {
  local marker
  [[ -f "$BACKEND_MARKER" && ! -L "$BACKEND_MARKER" ]] ||
    die "invalid Factory backend marker: $BACKEND_MARKER"
  marker=$(< "$BACKEND_MARKER")
  case "$marker" in
    docker | kubernetes) printf '%s' "$marker" ;;
    *) die "invalid Factory backend marker contents: $BACKEND_MARKER" ;;
  esac
}

write_backend_marker() {
  local backend=$1 temporary
  temporary=$(mktemp "$PRODUCT_ROOT/.factory-execution-backend.tmp.XXXXXX")
  printf '%s\n' "$backend" > "$temporary"
  chmod 600 "$temporary"
  if ln -- "$temporary" "$BACKEND_MARKER" 2>/dev/null; then
    rm -f -- "$temporary"
    return
  fi
  rm -f -- "$temporary"
  [[ -f "$BACKEND_MARKER" ]] || die "cannot create Factory backend marker: $BACKEND_MARKER"
}

enforce_execution_backend() {
  local installed_backend
  if [[ ! -e "$BACKEND_MARKER" && ! -L "$BACKEND_MARKER" ]]; then
    if compose_volume_exists workspaces || compose_volume_exists postgres-data; then
      write_backend_marker docker
    else
      if [[ "$EXECUTION_BACKEND" == kubernetes ]]; then
        preflight_kubernetes_profile
      fi
      write_backend_marker "$EXECUTION_BACKEND"
    fi
  fi
  installed_backend=$(read_backend_marker)
  [[ "$installed_backend" == "$EXECUTION_BACKEND" ]] ||
    die "this Factory installation is pinned to the '$installed_backend' execution backend, not '$EXECUTION_BACKEND'. Use a fresh Factory checkout with its own FACTORY_PROJECT_NAME and data volumes; automatic backend migration is not supported."
}

validate_dns_label() {
  local name=$1 value=$2
  [[ ${#value} -le 63 && "$value" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
    die "$name must be a Kubernetes DNS label"
}

validate_dns_subdomain() {
  local name=$1 value=$2 label
  local -a labels
  [[ ${#value} -le 253 && "$value" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
    die "$name must be a Kubernetes DNS subdomain"
  IFS='.' read -r -a labels <<< "$value"
  (( ${#labels[@]} > 0 )) || die "$name must be a Kubernetes DNS subdomain"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
      die "$name must be a Kubernetes DNS subdomain"
  done
}

validate_kubernetes_extended_resource_name() {
  local name=$1 value=$2 prefix resource label
  local -a labels
  [[ "$value" == */* && "$value" != */*/* ]] ||
    die "$name must be a fully qualified Kubernetes extended resource such as nvidia.com/gpu"
  prefix=${value%%/*}
  resource=${value#*/}
  [[ ${#prefix} -le 253 && "$prefix" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
    die "$name must be a fully qualified Kubernetes extended resource such as nvidia.com/gpu"
  IFS='.' read -r -a labels <<< "$prefix"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
      die "$name must be a fully qualified Kubernetes extended resource such as nvidia.com/gpu"
  done
  case "$prefix" in
    kubernetes.io | *.kubernetes.io | k8s.io | *.k8s.io)
      die "$name must use a non-Kubernetes domain prefix"
      ;;
  esac
  [[ ${#resource} -le 63 && "$resource" =~ ^[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$ ]] ||
    die "$name must be a fully qualified Kubernetes extended resource such as nvidia.com/gpu"
}

validate_factory_project_name() {
  [[ "$FACTORY_PROJECT_NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]] ||
    die 'FACTORY_PROJECT_NAME must start with a lowercase letter or digit and contain only lowercase letters, digits, underscore, and hyphen'
}

validate_kubernetes_image_reference() {
  local image=$1 name registry repository host port component label
  local -a components labels
  [[ "$image" =~ ^([^@]+)@sha256:([0-9a-f]{64})$ ]] ||
    die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  name=${BASH_REMATCH[1]}
  [[ ${#name} -le 255 && "$name" != *:*:* && "$name" == */* ]] ||
    die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  registry=${name%%/*}
  repository=${name#*/}
  [[ -n "$repository" && "$repository" != /* && "$repository" != */ && "$repository" != *//* ]] ||
    die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  host=$registry
  if [[ "$registry" == *:* ]]; then
    host=${registry%:*}
    port=${registry##*:}
    [[ "$port" =~ ^[0-9]{1,5}$ ]] &&
      (( 10#$port >= 1 && 10#$port <= 65535 )) ||
      die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  fi
  [[ ${#host} -le 253 && "$host" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] ||
    die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  IFS='.' read -r -a labels <<< "$host"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
      die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  done
  IFS='/' read -r -a components <<< "$repository"
  (( ${#components[@]} > 0 )) ||
    die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  for component in "${components[@]}"; do
    [[ "$component" =~ ^[a-z0-9]+([._-][a-z0-9]+)*$ ]] ||
      die 'FACTORY_KUBERNETES_IMAGE must be an immutable registry digest, such as ghcr.io/org/image@sha256:<64 lowercase hex characters>'
  done
}

kubernetes_project_slug() {
  local normalized hash
  normalized=$(printf '%s' "$FACTORY_PROJECT_NAME" | sed -E 's/[-_]+/-/g; s/-$//')
  if [[ "$normalized" != "$FACTORY_PROJECT_NAME" || ${#normalized} -gt 49 ]]; then
    hash=$(sha256_text "$FACTORY_PROJECT_NAME")
    normalized=${normalized:0:40}
    normalized=${normalized%-}
    normalized=$normalized-${hash:0:8}
  fi
  [[ ${#normalized} -le 49 && "$normalized" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
    die 'FACTORY_PROJECT_NAME cannot be converted to a Kubernetes DNS-1123 slug'
  printf '%s' "$normalized"
}

validate_workspace_host_path() {
  local path=$1
  [[ "$path" == /* ]] ||
    die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR must be an absolute path'
  [[ "$path" != / && "$path" != "$HOME" ]] ||
    die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR must not be a broad host directory'
  [[ "$path" =~ ^/[A-Za-z0-9._/-]+$ ]] ||
    die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR may contain only letters, digits, dot, underscore, slash, and hyphen'
  [[ "$path" != *'/../'* && "$path" != */.. ]] ||
    die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR contains an unsafe path component'
}

positive_integer() {
  local name=$1 value=$2
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || die "$name must be a positive integer"
}

nonnegative_u32() {
  local name=$1 value=$2 normalized
  [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a non-negative integer"
  normalized=$value
  while [[ ${#normalized} -gt 1 && ${normalized:0:1} == 0 ]]; do
    normalized=${normalized#0}
  done
  if (( ${#normalized} > 10 )) ||
    { (( ${#normalized} == 10 )) && [[ "$normalized" > 4294967295 ]]; }; then
    die "$name must be no greater than 4294967295"
  fi
  printf '%s' "$normalized"
}

select_kubectl() {
  local kubeconfig=$1
  if command -v kubectl >/dev/null 2>&1; then
    KUBECTL=(kubectl --kubeconfig "$kubeconfig")
  elif command -v k3s >/dev/null 2>&1; then
    KUBECTL=(k3s kubectl --kubeconfig "$kubeconfig")
  else
    die 'Kubernetes mode requires kubectl or k3s on the host'
  fi
}

sed_replacement() {
  printf '%s' "$1" | sed 's/[&|\\]/\\&/g'
}

preflight_kubernetes_profile() {
  local kubeconfig image workspace_mode workspace_host_dir workspace_root namespace pvc pv
  local cpu_request memory_request cpu_limit memory_limit readiness_seconds storage_gib
  local nodes node_rows node_count node_name node_pin kubeconfig_quoted runtime_class runtime_handler=''
  local pvc_state pvc_phase pvc_volume_mode pvc_access_modes
  local gpu_resource gpu_count gpu_nodes gpu_jsonpath node allocatable gpu_node_found=0

  (( KUBERNETES_PREFLIGHTED == 0 )) || return

  [[ "$(uname -s)" == Linux ]] || die 'Kubernetes execution is currently supported only on Linux hosts'
  kubeconfig=$(compose_environment_value FACTORY_KUBERNETES_KUBECONFIG)
  kubeconfig=${kubeconfig:-${XDG_CONFIG_HOME:-$HOME/.config}/software-factory/k3s.yaml}
  export FACTORY_KUBERNETES_KUBECONFIG=$kubeconfig
  [[ "$kubeconfig" == /* ]] || die 'FACTORY_KUBERNETES_KUBECONFIG must be an absolute path'
  if [[ ! -f "$kubeconfig" || ! -r "$kubeconfig" ]]; then
    printf -v kubeconfig_quoted '%q' "$kubeconfig"
    die "K3s kubeconfig must be readable by UID $HOST_UID at $kubeconfig. Run once: sudo install -D -m 600 -o $HOST_UID -g $HOST_GID /etc/rancher/k3s/k3s.yaml $kubeconfig_quoted"
  fi
  image=$(compose_environment_value FACTORY_KUBERNETES_IMAGE)
  validate_kubernetes_image_reference "$image"
  export FACTORY_KUBERNETES_IMAGE=$image

  workspace_mode=$KUBERNETES_WORKSPACE_MODE
  workspace_host_dir=$FACTORY_KUBERNETES_WORKSPACE_HOST_DIR
  validate_workspace_host_path "$workspace_host_dir"
  if [[ "$workspace_mode" == existing-pvc ]]; then
    [[ -d "$workspace_host_dir" ]] ||
      die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR must already exist when FACTORY_KUBERNETES_WORKSPACE_MODE=existing-pvc'
    [[ -w "$workspace_host_dir" ]] ||
      die 'FACTORY_KUBERNETES_WORKSPACE_HOST_DIR must be writable when FACTORY_KUBERNETES_WORKSPACE_MODE=existing-pvc'
    workspace_host_dir=$(cd -P "$workspace_host_dir" && pwd) ||
      die 'cannot resolve FACTORY_KUBERNETES_WORKSPACE_HOST_DIR'
    validate_workspace_host_path "$workspace_host_dir"
    export FACTORY_KUBERNETES_WORKSPACE_HOST_DIR=$workspace_host_dir
  fi

  workspace_root=$(compose_environment_value FACTORY_KUBERNETES_WORKSPACE_ROOT)
  workspace_root=${workspace_root:-/workspaces}
  [[ "$workspace_root" == /workspaces ]] ||
    die 'the Kubernetes profile requires FACTORY_KUBERNETES_WORKSPACE_ROOT=/workspaces'
  namespace=$(compose_environment_value FACTORY_KUBERNETES_NAMESPACE)
  pvc=$(compose_environment_value FACTORY_KUBERNETES_WORKSPACE_PVC)
  pv=$FACTORY_KUBERNETES_WORKSPACE_PV
  validate_dns_label FACTORY_KUBERNETES_NAMESPACE "$namespace"
  validate_dns_label FACTORY_KUBERNETES_WORKSPACE_PVC "$pvc"
  if [[ "$workspace_mode" == local ]]; then
    validate_dns_label FACTORY_KUBERNETES_WORKSPACE_PV "$pv"
  fi

  cpu_request=$(compose_environment_value FACTORY_KUBERNETES_CPU_REQUEST_MILLIS)
  memory_request=$(compose_environment_value FACTORY_KUBERNETES_MEMORY_REQUEST_MIB)
  cpu_limit=$(compose_environment_value FACTORY_KUBERNETES_CPU_LIMIT_MILLIS)
  memory_limit=$(compose_environment_value FACTORY_KUBERNETES_MEMORY_LIMIT_MIB)
  readiness_seconds=$(compose_environment_value FACTORY_KUBERNETES_READINESS_TIMEOUT_SECONDS)
  cpu_request=${cpu_request:-500}
  memory_request=${memory_request:-1024}
  cpu_limit=${cpu_limit:-2000}
  memory_limit=${memory_limit:-4096}
  readiness_seconds=${readiness_seconds:-120}
  positive_integer FACTORY_KUBERNETES_CPU_REQUEST_MILLIS "$cpu_request"
  positive_integer FACTORY_KUBERNETES_MEMORY_REQUEST_MIB "$memory_request"
  positive_integer FACTORY_KUBERNETES_CPU_LIMIT_MILLIS "$cpu_limit"
  positive_integer FACTORY_KUBERNETES_MEMORY_LIMIT_MIB "$memory_limit"
  positive_integer FACTORY_KUBERNETES_READINESS_TIMEOUT_SECONDS "$readiness_seconds"
  if [[ "$workspace_mode" == local ]]; then
    storage_gib=$(compose_environment_value FACTORY_KUBERNETES_WORKSPACE_SIZE_GIB)
    storage_gib=${storage_gib:-50}
    positive_integer FACTORY_KUBERNETES_WORKSPACE_SIZE_GIB "$storage_gib"
  else
    storage_gib=''
  fi
  (( cpu_limit >= cpu_request )) || die 'Kubernetes CPU limit must be at least its request'
  (( memory_limit >= memory_request )) || die 'Kubernetes memory limit must be at least its request'

  node_pin=$(compose_environment_value FACTORY_KUBERNETES_NODE_NAME)
  if [[ -n "$node_pin" ]]; then
    validate_dns_subdomain FACTORY_KUBERNETES_NODE_NAME "$node_pin"
  fi
  gpu_resource=$(compose_environment_value FACTORY_KUBERNETES_GPU_RESOURCE)
  gpu_resource=${gpu_resource:-nvidia.com/gpu}
  gpu_count=$(compose_environment_value FACTORY_KUBERNETES_GPU_COUNT)
  gpu_count=$(nonnegative_u32 FACTORY_KUBERNETES_GPU_COUNT "${gpu_count:-0}")
  if (( gpu_count > 0 )); then
    validate_kubernetes_extended_resource_name FACTORY_KUBERNETES_GPU_RESOURCE "$gpu_resource"
  fi
  export FACTORY_KUBERNETES_NODE_NAME=$node_pin
  export FACTORY_KUBERNETES_GPU_RESOURCE=$gpu_resource
  export FACTORY_KUBERNETES_GPU_COUNT=$gpu_count

  select_kubectl "$kubeconfig"
  if [[ "$workspace_mode" == local ]]; then
    nodes=$("${KUBECTL[@]}" get nodes -o 'jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}') ||
      die 'cannot list Kubernetes nodes with the configured kubeconfig'
    node_count=$(printf '%s\n' "$nodes" | awk 'NF { count++ } END { print count + 0 }')
    [[ "$node_count" == 1 ]] || die "the local workspace profile requires exactly one Kubernetes node; found $node_count"
    node_name=$(printf '%s\n' "$nodes" | awk 'NF { print; exit }')
    [[ -n "$node_name" && "$node_name" != *$'\n'* ]] || die 'Kubernetes returned an invalid node name'
    [[ -z "$node_pin" || "$node_pin" == "$node_name" ]] ||
      die "configured Kubernetes node '$node_pin' is not the local workspace node '$node_name'"
  else
    node_rows=$("${KUBECTL[@]}" get nodes -o 'jsonpath={range .items[*]}{.metadata.name}{"|"}{.spec.unschedulable}{"|"}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{"\n"}{end}') ||
      die 'cannot list Kubernetes nodes with the configured kubeconfig'
    nodes=$(printf '%s\n' "$node_rows" | awk -F '|' '$2 != "true" && $3 == "True" { print $1 }')
    node_count=$(printf '%s\n' "$nodes" | awk 'NF { count++ } END { print count + 0 }')
    (( node_count >= 1 )) || die 'the existing-pvc workspace mode requires at least one Ready schedulable Kubernetes node'
    node_name=''
    if [[ -n "$node_pin" ]] && ! printf '%s\n' "$nodes" | grep -Fxq -- "$node_pin"; then
      die "configured Kubernetes node '$node_pin' is not Ready and schedulable"
    fi

    pvc_state=$("${KUBECTL[@]}" -n "$namespace" get pvc "$pvc" -o 'jsonpath={.status.phase}{"|"}{.spec.volumeMode}{"|"}{range .spec.accessModes[*]}{@}{","}{end}') ||
      die "cannot read existing Kubernetes workspace PVC '$namespace/$pvc'"
    IFS='|' read -r pvc_phase pvc_volume_mode pvc_access_modes <<< "$pvc_state"
    [[ "$pvc_phase" == Bound ]] ||
      die "existing Kubernetes workspace PVC '$namespace/$pvc' must be Bound; found '${pvc_phase:-empty}'"
    [[ -z "$pvc_volume_mode" || "$pvc_volume_mode" == Filesystem ]] ||
      die "existing Kubernetes workspace PVC '$namespace/$pvc' must use Filesystem volume mode"
    case ",$pvc_access_modes" in
      *,ReadWriteMany,*) ;;
      *) die "existing Kubernetes workspace PVC '$namespace/$pvc' must include ReadWriteMany access" ;;
    esac
  fi

  if (( gpu_count > 0 )); then
    gpu_nodes=$nodes
    if [[ -n "$node_pin" ]]; then
      gpu_nodes=$node_pin
    fi
    gpu_jsonpath=${gpu_resource//./\\.}
    while IFS= read -r node; do
      [[ -n "$node" ]] || continue
      allocatable=$("${KUBECTL[@]}" get node "$node" -o "jsonpath={.status.allocatable.${gpu_jsonpath}}") ||
        die "cannot read Kubernetes extended resource '$gpu_resource' on node '$node'"
      allocatable=${allocatable:-0}
      [[ "$allocatable" =~ ^[0-9]+$ ]] ||
        die "Kubernetes node '$node' returned invalid allocatable '$gpu_resource' quantity '$allocatable'"
      if (( 10#$allocatable >= gpu_count )); then
        gpu_node_found=1
        break
      fi
    done <<< "$gpu_nodes"
    (( gpu_node_found == 1 )) ||
      die "no eligible Kubernetes node advertises at least $gpu_count of extended resource '$gpu_resource'"
  fi

  runtime_class=$(compose_environment_value FACTORY_KUBERNETES_RUNTIME_CLASS)
  if [[ -n "$runtime_class" ]]; then
    validate_dns_subdomain FACTORY_KUBERNETES_RUNTIME_CLASS "$runtime_class"
    if ! runtime_handler=$("${KUBECTL[@]}" get runtimeclass "$runtime_class" -o 'jsonpath={.handler}' 2>/dev/null); then
      die "configured Kubernetes RuntimeClass '$runtime_class' is unavailable; install it or clear FACTORY_KUBERNETES_RUNTIME_CLASS"
    fi
    [[ -n "$runtime_handler" ]] ||
      die "configured Kubernetes RuntimeClass '$runtime_class' has no handler"
  fi
  if [[ "$workspace_mode" == local ]]; then
    [[ -f "$KUBERNETES_WORKSPACE_TEMPLATE" ]] || die "missing $KUBERNETES_WORKSPACE_TEMPLATE"
  fi

  KUBERNETES_WORKSPACE_MODE=$workspace_mode
  KUBERNETES_NODE_NAME=$node_name
  KUBERNETES_EXECUTION_NODE_NAME=$node_pin
  KUBERNETES_SCHEDULABLE_NODE_COUNT=$node_count
  KUBERNETES_WORKSPACE_HOST_DIR=$workspace_host_dir
  KUBERNETES_NAMESPACE=$namespace
  KUBERNETES_WORKSPACE_PVC=$pvc
  KUBERNETES_WORKSPACE_PV=$pv
  KUBERNETES_WORKSPACE_SIZE_GIB=$storage_gib
  KUBERNETES_RUNTIME_CLASS=$runtime_class
  KUBERNETES_RUNTIME_HANDLER=$runtime_handler
  KUBERNETES_GPU_RESOURCE=$gpu_resource
  KUBERNETES_GPU_COUNT=$gpu_count
  KUBERNETES_PREFLIGHTED=1
}

prepare_kubernetes_profile() {
  local rendered workspace_host_dir node_summary='' gpu_summary=''

  preflight_kubernetes_profile
  workspace_host_dir=$KUBERNETES_WORKSPACE_HOST_DIR
  if [[ -n "$KUBERNETES_EXECUTION_NODE_NAME" ]]; then
    printf -v node_summary ', node %s' "$KUBERNETES_EXECUTION_NODE_NAME"
  fi
  if (( KUBERNETES_GPU_COUNT > 0 )); then
    printf -v gpu_summary ', GPU %s=%s' "$KUBERNETES_GPU_RESOURCE" "$KUBERNETES_GPU_COUNT"
  fi
  if [[ "$KUBERNETES_WORKSPACE_MODE" == existing-pvc ]]; then
    export FACTORY_KUBERNETES_WORKSPACE_HOST_DIR=$workspace_host_dir
    if [[ -n "$KUBERNETES_RUNTIME_CLASS" ]]; then
      printf 'Factory execution backend: kubernetes (worker factory-worker, existing PVC %s/%s, %s Ready schedulable node(s), RuntimeClass %s, handler %s%s%s)\n' \
        "$KUBERNETES_NAMESPACE" "$KUBERNETES_WORKSPACE_PVC" "$KUBERNETES_SCHEDULABLE_NODE_COUNT" \
        "$KUBERNETES_RUNTIME_CLASS" "$KUBERNETES_RUNTIME_HANDLER" "$node_summary" "$gpu_summary" >&2
    else
      printf 'Factory execution backend: kubernetes (worker factory-worker, existing PVC %s/%s, %s Ready schedulable node(s), cluster-default runtime%s%s)\n' \
        "$KUBERNETES_NAMESPACE" "$KUBERNETES_WORKSPACE_PVC" "$KUBERNETES_SCHEDULABLE_NODE_COUNT" \
        "$node_summary" "$gpu_summary" >&2
    fi
    return
  fi
  mkdir -p -- "$workspace_host_dir"
  workspace_host_dir=$(cd -P "$workspace_host_dir" && pwd)
  validate_workspace_host_path "$workspace_host_dir"
  chown "$HOST_UID:$HOST_GID" "$workspace_host_dir"
  export FACTORY_KUBERNETES_WORKSPACE_HOST_DIR=$workspace_host_dir

  rendered=$(mktemp "${TMPDIR:-/tmp}/factory-k3s-workspaces.XXXXXX.yaml")
  sed \
    -e "s|__FACTORY_NAMESPACE__|$(sed_replacement "$KUBERNETES_NAMESPACE")|g" \
    -e "s|__FACTORY_WORKSPACE_PV__|$(sed_replacement "$KUBERNETES_WORKSPACE_PV")|g" \
    -e "s|__FACTORY_WORKSPACE_PVC__|$(sed_replacement "$KUBERNETES_WORKSPACE_PVC")|g" \
    -e "s|__FACTORY_WORKSPACE_HOST_DIR__|$(sed_replacement "$workspace_host_dir")|g" \
    -e "s|__FACTORY_KUBERNETES_NODE_NAME__|$(sed_replacement "$KUBERNETES_NODE_NAME")|g" \
    -e "s|__FACTORY_WORKSPACE_SIZE_GIB__|$(sed_replacement "$KUBERNETES_WORKSPACE_SIZE_GIB")|g" \
    "$KUBERNETES_WORKSPACE_TEMPLATE" > "$rendered"
  if ! "${KUBECTL[@]}" apply -f "$rendered" >/dev/null; then
    rm -f -- "$rendered"
    die 'cannot apply the single-node Factory workspace manifest'
  fi
  rm -f -- "$rendered"
  if [[ -n "$KUBERNETES_RUNTIME_CLASS" ]]; then
    printf 'Factory execution backend: kubernetes (worker factory-worker, node %s, RuntimeClass %s, handler %s%s)\n' \
      "$KUBERNETES_NODE_NAME" "$KUBERNETES_RUNTIME_CLASS" "$KUBERNETES_RUNTIME_HANDLER" "$gpu_summary" >&2
  else
    printf 'Factory execution backend: kubernetes (worker factory-worker, node %s, cluster-default runtime%s)\n' \
      "$KUBERNETES_NODE_NAME" "$gpu_summary" >&2
  fi
}

configure_kubernetes_provider_url() {
  local provider=$1 configured port
  [[ "$EXECUTION_BACKEND" == kubernetes ]] || return
  case "$provider" in
    anthropic | claude)
      port=$(compose_environment_value CLAUDE_PROVIDER_PORT)
      export FACTORY_KUBERNETES_PROVIDER_BASE_URL="http://127.0.0.1:${port:-10103}/v1"
      ;;
    deepseek)
      port=$(compose_environment_value DEEPSEEK_PROVIDER_PORT)
      export FACTORY_KUBERNETES_PROVIDER_BASE_URL="http://127.0.0.1:${port:-10102}/v1"
      ;;
    zai)
      port=$(compose_environment_value FACTORY_PROVIDER_PORT)
      export FACTORY_KUBERNETES_PROVIDER_BASE_URL="http://127.0.0.1:${port:-10101}/v1"
      ;;
    openai)
      configured=$(compose_environment_value FACTORY_PROVIDER_BASE_URL)
      export FACTORY_KUBERNETES_PROVIDER_BASE_URL=$configured
      ;;
  esac
}

factory_image() {
  local image
  image=$(compose_environment_value FACTORY_IMAGE)
  printf '%s' "${image:-$DEFAULT_FACTORY_IMAGE}"
}

pull_factory_image() {
  local image
  image=$(factory_image)
  [[ "$image" == software-factory:local ]] && return
  printf 'Pulling Factory image %s\n' "$image" >&2
  docker pull "$image" >/dev/null
}

run_config_cli() {
  local image tty_flag=''
  up_coordinator
  image=$(factory_image)
  if [[ -t 0 && -t 1 ]]; then
    tty_flag='-it'
  fi
  if [[ -n "$tty_flag" ]]; then
    docker run --rm "$tty_flag" \
      --user "$HOST_UID:$HOST_GID" \
      --network "${FACTORY_PROJECT_NAME}_default" \
      --volume "$PRODUCT_ROOT:/factory-config" \
      --workdir /factory-config \
      --env FACTORY_CONFIG_FILE=/factory-config/.env \
      --env FACTORYD_URL=http://factoryd:8787 \
      --env OPENAI_API_KEY \
      --env ANTHROPIC_API_KEY \
      --env DEEPSEEK_API_KEY \
      --env ZAI_API_KEY \
      "$image" factory "$@"
  else
    docker run --rm \
      --user "$HOST_UID:$HOST_GID" \
      --network "${FACTORY_PROJECT_NAME}_default" \
      --volume "$PRODUCT_ROOT:/factory-config" \
      --workdir /factory-config \
      --env FACTORY_CONFIG_FILE=/factory-config/.env \
      --env FACTORYD_URL=http://factoryd:8787 \
      --env OPENAI_API_KEY \
      --env ANTHROPIC_API_KEY \
      --env DEEPSEEK_API_KEY \
      --env ZAI_API_KEY \
      "$image" factory "$@"
  fi
}

provider_key_variable() {
  case $1 in
    openai) printf '%s' OPENAI_API_KEY ;;
    anthropic | claude) printf '%s' ANTHROPIC_API_KEY ;;
    deepseek) printf '%s' DEEPSEEK_API_KEY ;;
    zai) printf '%s' ZAI_API_KEY ;;
    *) die "unsupported provider in .env: $1" ;;
  esac
}

provider_upstream_base_variable() {
  case $1 in
    openai) printf '%s' FACTORY_OPENAI_BASE_URL ;;
    anthropic | claude) printf '%s' FACTORY_CLAUDE_BASE_URL ;;
    deepseek) printf '%s' FACTORY_DEEPSEEK_BASE_URL ;;
    zai) printf '%s' FACTORY_ZAI_BASE_URL ;;
    *) die "unsupported provider in .env: $1" ;;
  esac
}

ensure_provider_configuration() {
  local provider model key_name key
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  model=$(compose_environment_value FACTORY_MODEL)
  if [[ -z "$provider" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      printf 'Welcome to Software Factory.\n' >&2
      run_config_cli configure
      return
    fi
    die 'provider is not configured; run `factory configure` first'
  fi
  [[ -n "$model" ]] || die 'model is not configured; run `factory model <id>`'
  key_name=$(provider_key_variable "$provider")
  key=$(compose_environment_value "$key_name")
  [[ -n "$key" ]] || die "$key_name is missing; run `factory provider $provider`"
}

provider_profile() {
  case $1 in
    anthropic | claude) printf '%s' claude ;;
    deepseek) printf '%s' deepseek ;;
    zai) printf '%s' zai ;;
    openai) printf '%s' '' ;;
    *) die "unsupported provider: $1" ;;
  esac
}

reconcile_provider_services() {
  local provider=$1
  local inactive=(claude-provider deepseek-provider zai-provider)
  case "$provider" in
    anthropic | claude) inactive=(deepseek-provider zai-provider) ;;
    deepseek) inactive=(claude-provider zai-provider) ;;
    zai) inactive=(claude-provider deepseek-provider) ;;
  esac
  compose --profile claude --profile deepseek --profile zai \
    rm --stop --force "${inactive[@]}" >/dev/null
}

up_stack() {
  local provider profile
  local services=(postgres qdrant factoryd)
  ensure_env_file
  select_execution_backend
  require_docker
  enforce_execution_backend
  ensure_artifact_root
  ensure_provider_configuration
  pull_factory_image
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  profile=$(provider_profile "$provider")
  configure_kubernetes_provider_url "$provider"
  if [[ "$EXECUTION_BACKEND" == kubernetes ]]; then
    prepare_kubernetes_profile
  else
    printf 'Factory execution backend: docker (worker factory-worker)\n' >&2
  fi
  reconcile_provider_services "$provider"
  if [[ -n "$profile" ]]; then
    services+=("$profile-provider")
    compose --profile "$profile" up -d --wait --wait-timeout 180 --remove-orphans "${services[@]}"
    compose --profile "$profile" up -d --wait --wait-timeout 180 --remove-orphans factory-worker
  else
    compose up -d --wait --wait-timeout 180 --remove-orphans "${services[@]}"
    compose up -d --wait --wait-timeout 180 --remove-orphans factory-worker
  fi
  printf 'Factory is ready for %s\n' "$PROJECT_DIR" >&2
}

up_coordinator() {
  ensure_env_file
  select_execution_backend
  require_docker
  enforce_execution_backend
  ensure_artifact_root
  pull_factory_image
  compose up -d --wait --wait-timeout 180 --remove-orphans postgres factoryd
}

require_service() {
  local service=$1 container_id
  container_id=$(compose ps --status running --quiet "$service" 2>/dev/null || true)
  [[ -n "$container_id" ]] || die "$service is not running; run '$0 up' first"
}

exec_factory_cli() {
  local provider model key_name key base_name base
  local -a provider_environment
  require_service factoryd
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  model=$(compose_environment_value FACTORY_MODEL)
  key_name=$(provider_key_variable "$provider")
  key=$(compose_environment_value "$key_name")
  [[ -n "$key" ]] || die "$key_name is missing; run `factory provider $provider`"
  base_name=$(provider_upstream_base_variable "$provider")
  base=$(compose_environment_value "$base_name")

  # Compose expands the configured values for the worker and provider bridge,
  # but `compose exec` does not automatically add them to the factory CLI
  # process. Export them locally and pass only their names so secret values do
  # not appear in the Docker command line or launcher output.
  export "$key_name=$key"
  export "$base_name=$base"
  provider_environment=(--env "$key_name" --env "$base_name")
  if [[ -t 0 && -t 1 ]]; then
    exec "${COMPOSE[@]}" exec \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      --env "FACTORY_PROVIDER_ADAPTER=$provider" \
      --env "FACTORY_MODEL=$model" \
      "${provider_environment[@]}" \
      factoryd factory "$@"
  else
    exec "${COMPOSE[@]}" exec -T \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      --env "FACTORY_PROVIDER_ADAPTER=$provider" \
      --env "FACTORY_MODEL=$model" \
      "${provider_environment[@]}" \
      factoryd factory "$@"
  fi
}

exec_factory_coordinator_cli() {
  require_service factoryd
  if [[ -t 0 && -t 1 ]]; then
    exec "${COMPOSE[@]}" exec \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      factoryd factory "$@"
  else
    exec "${COMPOSE[@]}" exec -T \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      factoryd factory "$@"
  fi
}

stream_factory_export() {
  local job_id=$1
  require_service factoryd
  "${COMPOSE[@]}" exec -T \
    --user "$HOST_UID:$HOST_GID" \
    --workdir /workspace/project \
    --env FACTORYD_URL=http://127.0.0.1:8787 \
    --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
    factoryd factory export "$job_id" --output -
}

export_result_to_host() {
  local job_id=${1-} destination='' parent base temporary status
  [[ -n "$job_id" ]] || die 'usage: factory export <job-id> [-o FILE]'
  shift
  destination="factory-$job_id.patch"
  while (( $# > 0 )); do
    case $1 in
      -o | --output)
        (( $# >= 2 )) || die 'export output path is missing'
        destination=$2
        shift 2
        ;;
      --output=*)
        destination=${1#*=}
        shift
        ;;
      *) die "unexpected export argument: $1" ;;
    esac
  done
  [[ -n "$destination" ]] || die 'export output path must not be empty'
  if [[ "$destination" == - ]]; then
    stream_factory_export "$job_id"
    return
  fi
  [[ ! -e "$destination" && ! -L "$destination" ]] ||
    die "export destination already exists: $destination"
  parent=$(dirname -- "$destination")
  base=$(basename -- "$destination")
  [[ -d "$parent" ]] || die "export destination directory does not exist: $parent"
  temporary=$(mktemp "$parent/.$base.factory-tmp.XXXXXX") ||
    die "cannot create temporary export beside $destination"
  if stream_factory_export "$job_id" > "$temporary"; then
    if ! ln -- "$temporary" "$destination"; then
      rm -f -- "$temporary"
      die "cannot publish export without overwriting: $destination"
    fi
    rm -f -- "$temporary"
    printf 'Exported job %s to %s\n' "$job_id" "$destination"
    return
  else
    status=$?
    rm -f -- "$temporary"
    return "$status"
  fi
}

run_task() {
  up_stack
  exec_factory_cli run "$@"
}

follow_logs() {
  local provider profile
  local services=(factoryd factory-worker)
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  profile=$(provider_profile "$provider")
  [[ -z "$profile" ]] || services+=("$profile-provider")
  compose logs --follow "${services[@]}"
}

install_cli() {
  local install_dir=${FACTORY_INSTALL_DIR:-$HOME/.local/bin}
  local target=$install_dir/factory expected=$PRODUCT_ROOT/factory
  mkdir -p "$install_dir"
  if [[ -L "$target" && "$(readlink "$target")" == "$expected" ]]; then
    printf 'factory is already installed at %s\n' "$target"
    return
  fi
  [[ ! -e "$target" ]] || die "$target already exists"
  ln -s "$expected" "$target"
  printf 'Installed factory at %s\n' "$target"
}

main() {
  local command=${1-}
  if (( $# == 0 )); then
    run_task
    return
  fi
  case "$command" in
    help | --help | -h)
      usage
      ;;
    run)
      shift
      run_task "$@"
      ;;
    configure | provider | model)
      shift
      run_config_cli "$command" "$@"
      ;;
    attach)
      shift
      up_stack
      exec_factory_cli "$command" "$@"
      ;;
    continue)
      shift
      up_stack
      exec_factory_cli continue "$@"
      ;;
    status | stop | result | artifacts)
      shift
      up_coordinator
      exec_factory_coordinator_cli "$command" "$@"
      ;;
    export)
      shift
      up_coordinator
      export_result_to_host "$@"
      ;;
    apply)
      shift
      up_coordinator
      exec_factory_coordinator_cli apply "$@"
      ;;
    logs)
      (( $# == 1 )) || die 'usage: factory logs'
      ensure_env_file
      select_execution_backend
      require_docker
      enforce_execution_backend
      follow_logs
      ;;
    up)
      (( $# == 1 )) || die 'usage: factory up'
      up_stack
      ;;
    down)
      (( $# == 1 )) || die 'usage: factory down'
      ensure_env_file
      select_execution_backend
      require_docker
      enforce_execution_backend
      compose --profile '*' down --remove-orphans
      ;;
    build)
      (( $# == 1 )) || die 'usage: factory build'
      ensure_env_file
      require_docker
      docker build \
        --build-arg "CARGO_BUILD_JOBS=${FACTORY_BUILD_JOBS:-2}" \
        --tag software-factory:local \
        "$PRODUCT_ROOT"
      printf 'Built software-factory:local. Set FACTORY_IMAGE=software-factory:local to use it.\n'
      ;;
    install)
      (( $# == 1 )) || die 'usage: factory install'
      install_cli
      ;;
    *)
      run_task "$@"
      ;;
  esac
}

main "$@"
