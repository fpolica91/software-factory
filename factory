#!/usr/bin/env bash
set -euo pipefail

readonly FACTORY_PROJECT_NAME='software-factory'
readonly DEFAULT_FACTORY_IMAGE='ghcr.io/fpolica91/software-factory:edge'

resolve_product_root() {
  local source_path=${BASH_SOURCE[0]} source_dir link_target
  while [[ -L "$source_path" ]]; do
    source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
    link_target=$(readlink "$source_path")
    if [[ "$link_target" == /* ]]; then
      source_path=$link_target
    else
      source_path=$source_dir/$link_target
    fi
  done
  cd -P "$(dirname "$source_path")" && pwd
}

find_project_dir() {
  local start git_root
  start=$(pwd -P)
  if command -v git >/dev/null 2>&1 &&
    git_root=$(git -C "$start" rev-parse --show-toplevel 2>/dev/null); then
    cd -P "$git_root" && pwd
  else
    printf '%s\n' "$start"
  fi
}

sha256_text() {
  local value=$1
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$value" | shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$value" | sha256sum | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    printf '%s' "$value" | openssl dgst -sha256 -r | awk '{print $1}'
  else
    printf '%s\n' 'factory: shasum, sha256sum, or openssl is required to identify the host repository' >&2
    return 1
  fi
}

readonly PRODUCT_ROOT=$(resolve_product_root)
readonly COMPOSE_FILE=$PRODUCT_ROOT/docker-compose.yml
readonly ENV_FILE=$PRODUCT_ROOT/.env
readonly ENV_EXAMPLE=$PRODUCT_ROOT/.env.example
readonly PROJECT_DIR=$(find_project_dir)
readonly HOST_REPOSITORY_ID="local:$(sha256_text "$PROJECT_DIR")"
readonly HOST_ARTIFACT_DIR=$PROJECT_DIR/.factory
readonly HOST_UID=$(id -u)
readonly HOST_GID=$(id -g)

export FACTORY_PROJECT_DIR=$PROJECT_DIR
export FACTORY_ARTIFACT_HOST_DIR=$HOST_ARTIFACT_DIR
export FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID
export FACTORY_RUN_AS_UID=$HOST_UID
export FACTORY_RUN_AS_GID=$HOST_GID

COMPOSE=(
  docker compose
  --project-directory "$PRODUCT_ROOT"
  --env-file "$ENV_FILE"
  --file "$COMPOSE_FILE"
  --project-name "$FACTORY_PROJECT_NAME"
)

die() {
  printf 'factory: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Software Factory

Usage:
  factory [task]                    Onboard if needed, then run a durable task
  factory run [--detach] [task...]  Start and optionally detach from a task
  factory run --no-apply [task...]  Keep the result for explicit apply/export
  factory run --repository URL ...  Run against a remote Git URL
  factory configure [options]       Configure provider, API key, endpoint, model
  factory configure --show          Show configuration without displaying keys
  factory provider [list|show|name] List, inspect, or switch providers
  factory model [list|model-id]      List or switch models
  factory attach <job-id>            Reattach with compact expandable output
  factory attach --verbose <job-id>  Replay every durable event in full
  factory status <job-id>            Show durable job and stage status
  factory result <job-id>            Print the complete durable result
  factory artifacts <job-id>         List fixed job artifacts and location
  factory stop <job-id>              Cancel a durable job
  factory apply <job-id>             Apply a result to this clean checkout
  factory export <job-id> [-o FILE]  Export a standard binary Git patch
  factory logs                       Follow worker, coordinator, and provider logs
  factory up                         Start the local Factory stack
  factory down                       Stop the stack while preserving data
  factory build                      Build the Rust image locally
  factory install                    Install this launcher in ~/.local/bin
  factory help                       Show this help

Provider automation uses the provider-specific key environment variable:
OPENAI_API_KEY, ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, or ZAI_API_KEY.
EOF
}

ensure_env_file() {
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_EXAMPLE" ]] || die "missing $ENV_EXAMPLE"
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
}

ensure_artifact_root() {
  local exclude_path exclude_parent
  mkdir -p "$HOST_ARTIFACT_DIR/jobs"

  if ! exclude_path=$(git -C "$PROJECT_DIR" rev-parse --git-path info/exclude 2>/dev/null); then
    return
  fi
  if [[ "$exclude_path" != /* ]]; then
    exclude_path=$PROJECT_DIR/$exclude_path
  fi
  exclude_parent=$(dirname -- "$exclude_path")
  mkdir -p "$exclude_parent"
  touch "$exclude_path"
  if ! grep -Fqx '/.factory/' "$exclude_path"; then
    printf '\n/.factory/\n' >> "$exclude_path"
  fi
}

compose() {
  "${COMPOSE[@]}" "$@"
}

# Docker Compose is the process that expands .env into every service. Reading
# its canonical environment here keeps launcher preflight and per-job pinning
# byte-for-byte aligned with the worker, including quoted literal characters.
compose_environment_value() {
  local key=$1 environment line value=''
  environment=$(compose config --environment) ||
    die "cannot read Compose environment from $ENV_FILE"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      value=${line#*=}
    fi
  done <<< "$environment"
  printf '%s' "$value"
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die 'Docker is required'
  docker compose version >/dev/null 2>&1 || die 'Docker Compose is required'
  docker info >/dev/null 2>&1 || die 'Docker is not running'
  [[ -f "$COMPOSE_FILE" ]] || die "missing $COMPOSE_FILE"
}

factory_image() {
  local image
  image=$(compose_environment_value FACTORY_IMAGE)
  printf '%s' "${image:-$DEFAULT_FACTORY_IMAGE}"
}

pull_factory_image() {
  local image
  image=$(factory_image)
  [[ "$image" == software-factory:local ]] && return
  printf 'Pulling Factory image %s\n' "$image" >&2
  docker pull "$image" >/dev/null
}

run_config_cli() {
  local image tty_flag=''
  up_coordinator
  image=$(factory_image)
  if [[ -t 0 && -t 1 ]]; then
    tty_flag='-it'
  fi
  if [[ -n "$tty_flag" ]]; then
    docker run --rm "$tty_flag" \
      --user "$HOST_UID:$HOST_GID" \
      --network "${FACTORY_PROJECT_NAME}_default" \
      --volume "$PRODUCT_ROOT:/factory-config" \
      --workdir /factory-config \
      --env FACTORY_CONFIG_FILE=/factory-config/.env \
      --env FACTORYD_URL=http://factoryd:8787 \
      --env OPENAI_API_KEY \
      --env ANTHROPIC_API_KEY \
      --env DEEPSEEK_API_KEY \
      --env ZAI_API_KEY \
      "$image" factory "$@"
  else
    docker run --rm \
      --user "$HOST_UID:$HOST_GID" \
      --network "${FACTORY_PROJECT_NAME}_default" \
      --volume "$PRODUCT_ROOT:/factory-config" \
      --workdir /factory-config \
      --env FACTORY_CONFIG_FILE=/factory-config/.env \
      --env FACTORYD_URL=http://factoryd:8787 \
      --env OPENAI_API_KEY \
      --env ANTHROPIC_API_KEY \
      --env DEEPSEEK_API_KEY \
      --env ZAI_API_KEY \
      "$image" factory "$@"
  fi
}

ensure_provider_configuration() {
  local provider model key_name key
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  model=$(compose_environment_value FACTORY_MODEL)
  if [[ -z "$provider" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      printf 'Welcome to Software Factory.\n' >&2
      run_config_cli configure
      return
    fi
    die 'provider is not configured; run `factory configure` first'
  fi
  [[ -n "$model" ]] || die 'model is not configured; run `factory model <id>`'
  case "$provider" in
    openai) key_name=OPENAI_API_KEY ;;
    anthropic | claude) key_name=ANTHROPIC_API_KEY ;;
    deepseek) key_name=DEEPSEEK_API_KEY ;;
    zai) key_name=ZAI_API_KEY ;;
    *) die "unsupported provider in .env: $provider" ;;
  esac
  key=$(compose_environment_value "$key_name")
  [[ -n "$key" ]] || die "$key_name is missing; run `factory provider $provider`"
}

provider_profile() {
  case $1 in
    anthropic | claude) printf '%s' claude ;;
    deepseek) printf '%s' deepseek ;;
    zai) printf '%s' zai ;;
    openai) printf '%s' '' ;;
    *) die "unsupported provider: $1" ;;
  esac
}

reconcile_provider_services() {
  local provider=$1
  local inactive=(claude-provider deepseek-provider zai-provider)
  case "$provider" in
    anthropic | claude) inactive=(deepseek-provider zai-provider) ;;
    deepseek) inactive=(claude-provider zai-provider) ;;
    zai) inactive=(claude-provider deepseek-provider) ;;
  esac
  compose --profile claude --profile deepseek --profile zai \
    rm --stop --force "${inactive[@]}" >/dev/null
}

up_stack() {
  local provider profile
  local services=(postgres qdrant factoryd)
  ensure_env_file
  ensure_artifact_root
  require_docker
  ensure_provider_configuration
  pull_factory_image
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  profile=$(provider_profile "$provider")
  reconcile_provider_services "$provider"
  if [[ -n "$profile" ]]; then
    services+=("$profile-provider")
    compose --profile "$profile" up -d --wait --wait-timeout 180 --remove-orphans "${services[@]}"
    compose --profile "$profile" up -d --wait --wait-timeout 180 --remove-orphans factory-worker
  else
    compose up -d --wait --wait-timeout 180 --remove-orphans "${services[@]}"
    compose up -d --wait --wait-timeout 180 --remove-orphans factory-worker
  fi
  printf 'Factory is ready for %s\n' "$PROJECT_DIR" >&2
}

up_coordinator() {
  ensure_env_file
  ensure_artifact_root
  require_docker
  pull_factory_image
  compose up -d --wait --wait-timeout 180 --remove-orphans postgres factoryd
}

require_service() {
  local service=$1 container_id
  container_id=$(compose ps --status running --quiet "$service" 2>/dev/null || true)
  [[ -n "$container_id" ]] || die "$service is not running; run '$0 up' first"
}

exec_factory_cli() {
  local provider model
  require_service factoryd
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  model=$(compose_environment_value FACTORY_MODEL)
  if [[ -t 0 && -t 1 ]]; then
    exec "${COMPOSE[@]}" exec \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      --env "FACTORY_PROVIDER_ADAPTER=$provider" \
      --env "FACTORY_MODEL=$model" \
      factoryd factory "$@"
  else
    exec "${COMPOSE[@]}" exec -T \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      --env "FACTORY_PROVIDER_ADAPTER=$provider" \
      --env "FACTORY_MODEL=$model" \
      factoryd factory "$@"
  fi
}

exec_factory_coordinator_cli() {
  require_service factoryd
  if [[ -t 0 && -t 1 ]]; then
    exec "${COMPOSE[@]}" exec \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      factoryd factory "$@"
  else
    exec "${COMPOSE[@]}" exec -T \
      --user "$HOST_UID:$HOST_GID" \
      --workdir /workspace/project \
      --env FACTORYD_URL=http://127.0.0.1:8787 \
      --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
      factoryd factory "$@"
  fi
}

stream_factory_export() {
  local job_id=$1
  require_service factoryd
  "${COMPOSE[@]}" exec -T \
    --user "$HOST_UID:$HOST_GID" \
    --workdir /workspace/project \
    --env FACTORYD_URL=http://127.0.0.1:8787 \
    --env "FACTORY_HOST_REPOSITORY_ID=$HOST_REPOSITORY_ID" \
    factoryd factory export "$job_id" --output -
}

export_result_to_host() {
  local job_id=${1-} destination='' parent base temporary status
  [[ -n "$job_id" ]] || die 'usage: factory export <job-id> [-o FILE]'
  shift
  destination="factory-$job_id.patch"
  while (( $# > 0 )); do
    case $1 in
      -o | --output)
        (( $# >= 2 )) || die 'export output path is missing'
        destination=$2
        shift 2
        ;;
      --output=*)
        destination=${1#*=}
        shift
        ;;
      *) die "unexpected export argument: $1" ;;
    esac
  done
  [[ -n "$destination" ]] || die 'export output path must not be empty'
  if [[ "$destination" == - ]]; then
    stream_factory_export "$job_id"
    return
  fi
  [[ ! -e "$destination" && ! -L "$destination" ]] ||
    die "export destination already exists: $destination"
  parent=$(dirname -- "$destination")
  base=$(basename -- "$destination")
  [[ -d "$parent" ]] || die "export destination directory does not exist: $parent"
  temporary=$(mktemp "$parent/.$base.factory-tmp.XXXXXX") ||
    die "cannot create temporary export beside $destination"
  if stream_factory_export "$job_id" > "$temporary"; then
    if ! ln -- "$temporary" "$destination"; then
      rm -f -- "$temporary"
      die "cannot publish export without overwriting: $destination"
    fi
    rm -f -- "$temporary"
    printf 'Exported job %s to %s\n' "$job_id" "$destination"
    return
  else
    status=$?
    rm -f -- "$temporary"
    return "$status"
  fi
}

run_task() {
  up_stack
  exec_factory_cli run "$@"
}

follow_logs() {
  local provider profile
  local services=(factoryd factory-worker)
  provider=$(compose_environment_value FACTORY_PROVIDER_ADAPTER)
  profile=$(provider_profile "$provider")
  [[ -z "$profile" ]] || services+=("$profile-provider")
  compose logs --follow "${services[@]}"
}

install_cli() {
  local install_dir=${FACTORY_INSTALL_DIR:-$HOME/.local/bin}
  local target=$install_dir/factory expected=$PRODUCT_ROOT/factory
  mkdir -p "$install_dir"
  if [[ -L "$target" && "$(readlink "$target")" == "$expected" ]]; then
    printf 'factory is already installed at %s\n' "$target"
    return
  fi
  [[ ! -e "$target" ]] || die "$target already exists"
  ln -s "$expected" "$target"
  printf 'Installed factory at %s\n' "$target"
}

main() {
  local command=${1-}
  if (( $# == 0 )); then
    run_task
    return
  fi
  case "$command" in
    help | --help | -h)
      usage
      ;;
    run)
      shift
      run_task "$@"
      ;;
    configure | provider | model)
      shift
      run_config_cli "$command" "$@"
      ;;
    attach)
      shift
      up_stack
      exec_factory_cli "$command" "$@"
      ;;
    status | stop | result | artifacts)
      shift
      up_coordinator
      exec_factory_coordinator_cli "$command" "$@"
      ;;
    export)
      shift
      up_coordinator
      export_result_to_host "$@"
      ;;
    apply)
      shift
      up_coordinator
      exec_factory_coordinator_cli apply "$@"
      ;;
    logs)
      (( $# == 1 )) || die 'usage: factory logs'
      ensure_env_file
      require_docker
      follow_logs
      ;;
    up)
      (( $# == 1 )) || die 'usage: factory up'
      up_stack
      ;;
    down)
      (( $# == 1 )) || die 'usage: factory down'
      ensure_env_file
      require_docker
      compose --profile '*' down --remove-orphans
      ;;
    build)
      (( $# == 1 )) || die 'usage: factory build'
      ensure_env_file
      require_docker
      docker build \
        --build-arg "CARGO_BUILD_JOBS=${FACTORY_BUILD_JOBS:-2}" \
        --tag software-factory:local \
        "$PRODUCT_ROOT"
      printf 'Built software-factory:local. Set FACTORY_IMAGE=software-factory:local to use it.\n'
      ;;
    install)
      (( $# == 1 )) || die 'usage: factory install'
      install_cli
      ;;
    *)
      run_task "$@"
      ;;
  esac
}

main "$@"
