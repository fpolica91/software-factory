# Copy to .env; the repository ignores that file. Normal use pulls this image.
FACTORY_IMAGE=ghcr.io/fpolica91/software-factory:edge
POSTGRES_PASSWORD=factory-local

# Durable worker defaults.
FACTORY_WORKER_SLOTS=4
FACTORY_LEASE_SECONDS=900
FACTORY_QDRANT_API_KEY=
FACTORY_QDRANT_COLLECTION=factory_memories
# Deployment partition only; memory is always isolated by repository as well.
FACTORY_MEMORY_NAMESPACE=factory-global

# Managed automatically by the local `factory` CLI.
FACTORY_PROJECT_DIR=.
# Set by the host launcher to the invoking checkout's private artifact root.
FACTORY_ARTIFACT_HOST_DIR=.factory
FACTORY_RUN_AS_UID=
FACTORY_RUN_AS_GID=
# Docker Engine socket mounted only into the worker for per-job exec-server provisioning.
FACTORY_DOCKER_SOCKET=/var/run/docker.sock
FACTORY_EXECUTION_ENVIRONMENT_BACKEND=docker
# Usually discovered from the worker; set only when it joins multiple networks.
FACTORY_DOCKER_NETWORK=

# Optional Kubernetes execution profile. Set the backend to `kubernetes` only
# after a matching image and kubeconfig are available on this Linux host.
# Empty uses ${XDG_CONFIG_HOME:-$HOME/.config}/software-factory/k3s.yaml.
# Copy the K3s admin kubeconfig there once with the command printed by `factory`.
FACTORY_KUBERNETES_KUBECONFIG=
# Required when the backend is kubernetes. Use a cluster-reachable immutable
# registry/repository@sha256:<64 lowercase hex> reference. The supported subset
# is a lowercase DNS/IPv4-style registry with an optional numeric port and
# lowercase repository components separated by single `.`, `_`, or `-`
# characters. Bracketed IPv6 and tag+digest references are unsupported.
FACTORY_KUBERNETES_IMAGE=
# `local` creates a single-node local PV/PVC. `existing-pvc` uses an
# operator-managed RWX claim and never creates or changes cluster storage.
FACTORY_KUBERNETES_WORKSPACE_MODE=local
# In local mode, empty uses ${XDG_DATA_HOME:-$HOME/.local/share}/software-factory/$FACTORY_PROJECT_NAME/workspaces.
# In existing-pvc mode this must be an existing writable host mount backed by
# the same shared filesystem as the PVC; Factory cannot prove that relationship.
FACTORY_KUBERNETES_WORKSPACE_HOST_DIR=
# Empty names derive uniquely from FACTORY_PROJECT_NAME in local mode.
# Namespace and PVC are required explicitly in existing-pvc mode.
FACTORY_KUBERNETES_NAMESPACE=
# Local mode only.
FACTORY_KUBERNETES_WORKSPACE_PV=
FACTORY_KUBERNETES_WORKSPACE_PVC=
FACTORY_KUBERNETES_WORKSPACE_ROOT=/workspaces
# Local mode only.
FACTORY_KUBERNETES_WORKSPACE_SIZE_GIB=50
# Empty uses the cluster default runtime. After installing the pinned Kata
# profile, use kata-qemu-runtime-rs; `factory up` verifies the class exists.
FACTORY_KUBERNETES_RUNTIME_CLASS=
FACTORY_KUBERNETES_READINESS_TIMEOUT_SECONDS=120
FACTORY_KUBERNETES_CPU_REQUEST_MILLIS=500
FACTORY_KUBERNETES_MEMORY_REQUEST_MIB=1024
FACTORY_KUBERNETES_CPU_LIMIT_MILLIS=2000
FACTORY_KUBERNETES_MEMORY_LIMIT_MIB=4096

# Active provider settings. Run `./factory configure` to populate them.
# Job input can select a model/provider over the configured deployment defaults.
FACTORY_PROVIDER_ADAPTER=
FACTORY_MODEL=
FACTORY_PROVIDER_BASE_URL=
FACTORY_MODEL_CATALOG_JSON=

# Provider-scoped keys are retained locally so `factory provider` can switch back
# without asking again. Compose injects configured keys into the worker, but the
# selected provider and model determine the only key and endpoint Codex uses.
# Each optional adapter service receives only its own provider key.
OPENAI_API_KEY=
FACTORY_OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
FACTORY_CLAUDE_BASE_URL=https://api.anthropic.com

# Optional Z.AI adapter. `factory provider zai` prompts for Coding or Standard.
ZAI_API_KEY=
FACTORY_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Coding Plan override: https://api.z.ai/api/coding/paas/v4

# Optional DeepSeek adapter.
DEEPSEEK_API_KEY=
FACTORY_DEEPSEEK_BASE_URL=https://api.deepseek.com

# `artifacts` profile.
ARTIFACTS_MINIO_USER=factory
ARTIFACTS_MINIO_PASSWORD=factory-local-secret

# `observability` profile. Set these values before enabling it.
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Must be exactly 64 hexadecimal characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=

# Optional host port overrides.
FACTORYD_PORT=8787
POSTGRES_PORT=5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
FACTORY_PROVIDER_PORT=10101
DEEPSEEK_PROVIDER_PORT=10102
CLAUDE_PROVIDER_PORT=10103
COORDINATION_REDIS_PORT=6379
ARTIFACTS_PORT=9000
ARTIFACTS_CONSOLE_PORT=9001
OLLAMA_PORT=11434
LANGFUSE_PORT=3000
