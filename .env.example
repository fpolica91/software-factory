# Copy to .env; the repository ignores that file. Normal use pulls this image.
FACTORY_IMAGE=ghcr.io/fpolica91/software-factory:edge
POSTGRES_PASSWORD=factory-local

# Durable worker defaults.
FACTORY_WORKER_SLOTS=4
FACTORY_LEASE_SECONDS=900
FACTORY_QDRANT_API_KEY=
FACTORY_QDRANT_COLLECTION=factory_memories
# Deployment partition only; memory is always isolated by repository as well.
FACTORY_MEMORY_NAMESPACE=factory-global

# Managed automatically by the local `factory` CLI.
FACTORY_PROJECT_DIR=.
FACTORY_RUN_AS_UID=
FACTORY_RUN_AS_GID=

# Active provider settings. Run `./factory configure` to populate them.
# Job input can select a model/provider over the configured deployment defaults.
FACTORY_PROVIDER_ADAPTER=
FACTORY_MODEL=
FACTORY_PROVIDER_BASE_URL=
FACTORY_MODEL_CATALOG_JSON=

# Provider-scoped keys are retained locally so `factory provider` can switch back
# without asking again. Compose injects configured keys into the worker, but the
# selected provider and model determine the only key and endpoint Codex uses.
# Each optional adapter service receives only its own provider key.
OPENAI_API_KEY=
FACTORY_OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
FACTORY_CLAUDE_BASE_URL=https://api.anthropic.com

# Optional Z.AI adapter. `factory provider zai` prompts for Coding or Standard.
ZAI_API_KEY=
FACTORY_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Coding Plan override: https://api.z.ai/api/coding/paas/v4

# Optional DeepSeek adapter.
DEEPSEEK_API_KEY=
FACTORY_DEEPSEEK_BASE_URL=https://api.deepseek.com

# `artifacts` profile.
ARTIFACTS_MINIO_USER=factory
ARTIFACTS_MINIO_PASSWORD=factory-local-secret

# `observability` profile. Set these values before enabling it.
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Must be exactly 64 hexadecimal characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=

# Optional host port overrides.
FACTORYD_PORT=8787
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
FACTORY_PROVIDER_PORT=10101
DEEPSEEK_PROVIDER_PORT=10102
CLAUDE_PROVIDER_PORT=10103
COORDINATION_REDIS_PORT=6379
ARTIFACTS_PORT=9000
ARTIFACTS_CONSOLE_PORT=9001
OLLAMA_PORT=11434
LANGFUSE_PORT=3000
