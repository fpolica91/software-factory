# Copy to .env; the repository ignores that file.
FACTORY_IMAGE=software-factory:local
POSTGRES_PASSWORD=factory-local

# Managed automatically by the local `factory` CLI.
HATCHET_CLIENT_TOKEN=
HATCHET_PUBLIC_URL=http://localhost:8888
HATCHET_COOKIE_DOMAIN=localhost
FACTORY_WORKFLOW_SLOTS=4
FACTORY_HATCHET_TASK_RETRIES=20
FACTORY_LEASE_SECONDS=900
FACTORY_QDRANT_COLLECTION=factory_memories
FACTORY_MEMORY_NAMESPACE=factory-global
FACTORY_INTEGRATION_PLUGINS_JSON=[]

# Managed automatically by the local `factory` CLI.
FACTORY_PROJECT_DIR=.
FACTORY_RUN_AS_UID=
FACTORY_RUN_AS_GID=

# Direct Responses-provider settings. Run `./factory configure` to populate them.
# Job input overrides deployment defaults; operation input wins last.
FACTORY_PROVIDER_ADAPTER=
FACTORY_MODEL=
FACTORY_MODEL_PROVIDER=
FACTORY_PROVIDER_NAME=Software Factory deployment provider
FACTORY_PROVIDER_BASE_URL=
FACTORY_PROVIDER_AUTH=key
FACTORY_PROVIDER_API_KEY=
FACTORY_MODEL_CATALOG_JSON=

# Optional `zai` adapter. Select it explicitly with `./factory configure --preset zai`.
# Within that preset, the exact model is glm-5.2 and Coding Plan is the default URL.
ZAI_API_KEY=
FACTORY_PROVIDER_BRIDGE_TOKEN=
FACTORY_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Standard API alternative: https://api.z.ai/api/paas/v4/

# `artifacts` profile.
ARTIFACTS_MINIO_USER=factory
ARTIFACTS_MINIO_PASSWORD=factory-local-secret

# `observability` profile. Set these values before enabling it.
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Must be exactly 64 hexadecimal characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_USER=langfuse
LANGFUSE_MINIO_PASSWORD=

# Optional host port overrides.
FACTORYD_PORT=8787
HATCHET_PORT=8888
HATCHET_GRPC_PORT=7077
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
FACTORY_PROVIDER_PORT=10101
COORDINATION_REDIS_PORT=6379
ARTIFACTS_PORT=9000
ARTIFACTS_CONSOLE_PORT=9001
OLLAMA_PORT=11434
LANGFUSE_PORT=3000
