{
  "name": "@software-factory/harness-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol/v1": {
      "types": "./dist/protocol/v1/index.d.ts",
      "import": "./dist/protocol/v1/index.js"
    },
    "./codex-v2": {
      "types": "./dist/codex-v2/index.d.ts",
      "import": "./dist/codex-v2/index.js"
    },
    "./codex-v2/v2": {
      "types": "./dist/codex-v2/v2.d.ts",
      "import": "./dist/codex-v2/v2.js"
    }
  },
  "scripts": {
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "check:protocol": "node scripts/sync-protocol.mjs --check",
    "sync:codex-v2": "node scripts/sync-codex-v2.mjs",
    "check:codex-v2": "node scripts/sync-codex-v2.mjs --check",
    "build": "npm run check:protocol && npm run check:codex-v2 && tsc -p tsconfig.json",
    "smoke:manifest": "node scripts/manifest-handshake-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:glm": "node scripts/glm-tool-smoke.mjs",
    "smoke:glm:plan": "node scripts/glm-plan-resume-smoke.mjs",
    "smoke:glm:factory-state": "node scripts/glm-factory-state-smoke.mjs",
    "smoke:glm:factoryd-state": "node scripts/glm-factoryd-state-resume-smoke.mjs",
    "smoke:codex-v2": "node scripts/codex-v2-smoke.mjs",
    "smoke:kernel-parity": "node scripts/kernel-parity-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
