fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all -- --check

build:
    cargo build --locked --workspace \
      --bin factory \
      --bin factory-worker \
      --bin factoryd \
      --bin factory-provider-bridge

clippy:
    cargo clippy --locked --all-targets -- -D warnings

test:
    cargo nextest run --locked

test-compile:
    cargo test --locked --no-run
